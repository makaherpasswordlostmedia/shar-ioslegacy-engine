#define F_NOIDX 16
#define F_V12 32
#define FOG_NEAR .06f
#define FARPROBE_KEY 0xff00ff
static GroundCover groundCover;static ColWorld world;static Car car;
static struct{int state;} cl[1]={{2}};static int haveCol=1;static unsigned npc=1,ntex=1,ncell=1;static int farProbe,fogCityOld,oldFog;
static float drawDist=250,fogK,fogNear,fogFar;static unsigned fogCol=0x112233,fogValue;
static int draws;static GroundCoverVertex vertices[10];
void sceGumMatrixMode(int a){(void)a;}void sceGumStoreMatrix(ScePspFMatrix4*m){memset(m,0,sizeof *m);m->x.x=m->y.y=m->z.z=m->w.w=1;}
void sceGuFog(float n,float f,unsigned col){fogNear=n;fogFar=f;fogValue=col;}
void sceGuDepthOffset(int a){(void)a;}
int sceGuGetStatus(int a){(void)a;return 0;}
void sceGuDisable(int a){(void)a;}void sceGuEnable(int a){(void)a;}
void sceGuDrawArray(int a,int b,int n,const void*i,const void*v){(void)a;(void)b;(void)i;draws=n;memcpy(vertices,v,sizeof vertices);}
typedef struct {short u,v;unsigned c;short x,y,z,pad;} Vert;
typedef struct {int w,h,levels;void*pal;void*lv[8];void*slv[8];int pre;float slope;int t4;const void*opqPal;int opq;} Tex;
typedef struct {float bb[6];int tex,flags,nv,ni,owner;float ox,oy,oz,sc;unsigned off,nf,cell,pad[2];} Rec;
typedef struct {Rec r;float cx,cy,cz,rad;Vert*v;unsigned short*idx,*fidx;void*ggBatch;} Piece;
static Tex tex[1];static Piece pc[1];
