#!/bin/sh
# Двойной клик: боты по всем уровням 1–7 и всем рискам (правка Роба 415), ночью до 07:00 (tools/bots/allrisk.py --night).
# Только процессор Мака: без AI, без API, без сети, без эмулятора и окон игры, без звука. Расписания (launchd) не ставит.
# caffeinate не даёт Маку уснуть, пока идёт прогон, и отпускает сам. Остановить — закрыть окно (итог по готовым кругам пишется).
# Утром: build/bots/allrisk/<дата>-night/РЕЗУЛЬТАТ.md (сравнение с прошлой ночью, флаги, повтор каждого случая)
cd "$(dirname "$0")/../.."
exec caffeinate -ims python3 tools/bots/allrisk.py --night "$@"
