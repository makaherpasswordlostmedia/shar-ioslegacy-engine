#!/bin/sh
# Двойной клик перед сном (пункт Б5): боты-игроки до 07:00 на 8 процессах с низким приоритетом — каскадёр и пешеход,
# догонялки, миссионер и навигатор (tools/bots/night.py). Только процессор Мака, без AI и сети, на PSP ничего.
# caffeinate не даёт Маку уснуть, пока идёт ночь, и отпускает сам. Утром: build/bots/morning.md (одна страница).
cd "$(dirname "$0")/../.."
exec caffeinate -ims python3 tools/bots/night.py --procs 8 --until 07:00 "$@"
