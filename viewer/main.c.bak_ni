#define BUF_W 512
#define SCR_W 480
#define SCR_H 272
// Режим дальности (docs/ДОП_АУДИТ_2026-09-27.md), SELECT переключает: 1 = ровные 30 FPS и город до DIST_LONG,
// 0 = 60 FPS и 115 м (как v8). Файл view60 рядом с EBOOT — старт в режиме 60. Физика машины — подшаги 1/120 в любом.
#define DIST_LONG 250.f
#define DIST_SHORT 115.f
#define PVS_RANGE 115.f   // PVS (tools/pvs.c DRAW) посчитан до 115 м; дальше куски берём по пирамиде клетками
static int longView = 1;
#define LOAD_DIST (drawDist + 75.f)    // запас над дальностью: клетка успевает прочитаться до того, как войдёт в кадр (115 -> 190 м)
#define DROP_DIST (drawDist + 145.f)   // выгрузка с гистерезисом (115 -> 260 м ~3.3 МБ; 250 -> 395 м ~5.4 МБ, tools/budget.py --sweep)
#define LOD_DIST 50.f
#define CONE_COS 0.60f
#define CONE_SIN 0.80f
#define FOVY 62.f
#define ASPECT (16.f / 9.f)
#define SKY 0xffe0b070

// переключатели: всё, что влияет на скорость, можно выключить по отдельности (тест P2 так и меряет)
enum {
  O_SWZ = 1, O_TEX = 2, O_TRI = 4, O_PVS = 8, O_PLANES = 16, O_LEAN = 32, O_FAR = 64, O_SKY = 128,
  O_SKYCULL = 256, O_QVP = 512, O_D100 = 1024, O_HUD = 2048
};
#define O_DEFAULT (O_SWZ | O_TEX | O_TRI | O_PVS | O_PLANES | O_LEAN | O_FAR | O_SKY | O_SKYCULL | O_HUD)
static unsigned opt = O_DEFAULT;

static unsigned int __attribute__((aligned(64))) list[65536];

typedef struct { short u, v; unsigned int c; short x, y, z, pad; } Vert;
typedef struct { int w, h, levels; void *pal; void *lv[8]; void *slv[8]; } Tex;
typedef struct {
  float bb[6]; int tex, flags, nv, ni, owner; float ox, oy, oz, sc; unsigned off, nf, cell, pad[2];
} Rec;
typedef struct { Rec r; float cx, cy, cz, rad; Vert *v; unsigned short *idx, *fidx; } Piece;
typedef struct {
  float bb[6]; unsigned first, n, owner, off, size, pad;
  float cx, cy, cz, rad;
  volatile int state;           // 0 нет, 1 грузится, 2 готов, 3 нет памяти
  void *mem;
} Cell;

static Tex *tex; static unsigned ntex, npc, ncell;
static Piece *pc; static Cell *cl;
static unsigned short *carP, *skyP; static int ncarP, nskyP;
static short *hm, *wl; static float hox, hoz, hcell; static int hw, hh;
static unsigned *pvsEnt; static unsigned short *pvsPool; static float pvsOx, pvsOz, pvsCell; static int pvsW, pvsH;
static char path[256];
static ColWorld world; static int haveCol, autodrive, slowmo; static float adT, adStop; static Car car;   // этап 2: честная коллизия (секция COL1)
static Props props; static int haveProps; static Coins coins; static int haveCoins; static float prevDmg; static int wasDestroyed;   // этап 3б: сбиваемые пропы (секция PRP1)
static StateProps sprops; static int haveSP;   // SPR1: ящики, автоматы, будки, колонки, кусты-шары, щитки m4 + обломки деревьев/стекла/знаков
// сбитый DynaPhys с обломком BreakableObject: проиграть обломок в его исходной точке; 1 — у обломка есть меши, проп спрятать
// + частицы удара по таблице ATC типа (PRP2 @44): обломок (вода гидранта, листья/щепа деревьев, стекло Krusty) и
// система частиц (3 куст, 4 мусор, 5 листья дуба, 6 почта) — родные из fx.shr; eSpark (фонари) — искры кодом
static int onPropKick(void *u, unsigned i, float dx, float dz) {
  (void)u;
  float pos[3] = {props.def[i].x, props.def[i].y, props.def[i].z};
  int part, brk; propsTypeFx(&props, props.def[i].type, &part, &brk);
  if (brk >= 0) fxBurstBreakable(brk, pos, NULL);
  if (part >= 3) fxBurst(fxFindInst(part), pos, NULL);
  else if (part == 1)
    for (int k = 0; k < 14; k++) {
      float r1 = rand() * (1.f / RAND_MAX) - .5f, r2 = rand() * (1.f / RAND_MAX), r3 = rand() * (1.f / RAND_MAX) - .5f;
      fxSpawn(FX_SPARK, pos[0], pos[1] + .8f, pos[2], r1 * 8.f + dx * 3.f, r2 * 5.f + 1.f, r3 * 8.f + dz * 3.f);
    }
  if (!haveSP) return 0;
  int b = spBreakOf(&sprops, props.def[i].type); if (b < 0) return 0;
  return spBreak(&sprops, (unsigned)b, pos, props.def[i].q);
}
static CarVis cv; static int haveCarVis, carSeq; static float camAng;   // carSeq/camAng — служебное (carseq.txt, camang.txt)   // CAR1: визуальный слой машины (viewer/carvis.c)
static SceUID sema; static volatile int req = -1; static volatile unsigned loadedBytes = 0;

static int exitCb(int a, int b, void *c) { sceKernelExitGame(); return 0; }
static int cbThread(SceSize a, void *b) {
  int id = sceKernelCreateCallback("exit", exitCb, NULL);
  sceKernelRegisterExitCallback(id); sceKernelSleepThreadCB(); return 0;
}
static void fail(const char *msg) {
  pspDebugScreenInit(); pspDebugScreenPrintf("SHAR PSP\n\n%s\n\nPress HOME to exit.", msg);
  sceKernelSleepThread();
}
static void sibling(char *out, const char *name) {   // путь к файлу рядом с EBOOT
  strcpy(out, path); char *sl = strrchr(out, '/'); strcpy(sl ? sl + 1 : out, name);
}

// ---------- стриминг клеток ----------
static void loadCell(SceUID fd, int i) {
  Cell *c = &cl[i];
  void *m = memalign(16, c->size);
  if (!m) { c->state = 3; return; }
  sceIoLseek32(fd, c->off, PSP_SEEK_SET);
  if (sceIoRead(fd, m, c->size) != (int)c->size) { free(m); c->state = 3; return; }
  sceKernelDcacheWritebackRange(m, c->size);
  for (unsigned k = c->first; k < c->first + c->n; k++) {
    Piece *d = &pc[k]; char *b = (char *)m + d->r.off;
    d->v = (Vert *)b;
    d->idx = (unsigned short *)(b + ((d->r.nv * sizeof(Vert) + 15) & ~15));
    d->fidx = (unsigned short *)((char *)d->idx + ((d->r.ni * 2 + 15) & ~15));
  }
  c->mem = m; loadedBytes += c->size;
  __asm__ volatile("" ::: "memory");      // указатели кусков записаны раньше, чем state = 2
  c->state = 2;
}
static int visBox(const float *b, float ox, float oy, float oz); static float boxD2(const float *b); static float drawDist, eyeX, eyeY, eyeZ, cfX, cfY, cfZ;
// очередь загрузчика (как стриминг GTA LCS / Crash): главный поток раз в кадр кладёт до LQ_N лучших клеток
// (ближние и те, что впереди по ходу), загрузчик берёт их подряд, не дожидаясь следующего кадра.
// state: 0 -> 1 ставит только загрузчик, 2/3 -> 0 только главный поток — гонок нет.
#define LQ_N 8
static volatile short lq[LQ_N]; static volatile int lqn, loaderBusy;
static unsigned slowIoKBs;   // служебное (файл slowio рядом с EBOOT): имитация медленной карты памяти, КБ/с
static unsigned stLoads, stLoadUs;   // статистика: число загрузок и суммарное время чтения
static int loaderThread(SceSize a, void *b) {
  SceUID fd = sceIoOpen(path, PSP_O_RDONLY, 0);
  for (;;) {
    sceKernelWaitSema(sema, 1, NULL);
    for (;;) {                                       // пока в очереди есть незагруженное — грузим подряд
      int n = lqn, i = -1;
      for (int k = 0; k < n && k < LQ_N; k++) { int j = lq[k]; if (j >= 0 && j < (int)ncell && cl[j].state == 0) { i = j; break; } }
      if (i < 0 || fd < 0) break;
      loaderBusy = 1; cl[i].state = 1;
      unsigned t0 = sceKernelGetSystemTimeLow();
      if (slowIoKBs) sceKernelDelayThread(6000 + cl[i].size * 1000u / slowIoKBs);   // ~6 мс на поиск + скорость чтения
      loadCell(fd, i);
      stLoadUs += sceKernelGetSystemTimeLow() - t0; stLoads++;
      __asm__ volatile("" ::: "memory");
    }
    loaderBusy = 0;
  }
  return 0;
}
static void unloadCell(Cell *c) {
  if (c->state == 2) { loadedBytes -= c->size; free(c->mem); c->mem = 0; }
  c->state = 0;
}
static float cellDist(Cell *c, float x, float y, float z) {
  float dx = c->cx - x, dy = c->cy - y, dz = c->cz - z;
  return sqrtf(dx * dx + dy * dy + dz * dz) - c->rad;
}
// выгрузить далёкое, отдать загрузчику очередь нужных клеток; 1 = ещё что-то грузится.
// Приоритет: расстояние до глаза или до точки, где камера будет через STREAM_AHEAD с (что меньше);
// клетки в кадре — вперёд. Радиус загрузки LOAD_DIST (с запасом над дальностью 115 м), выгрузки — DROP_DIST.
#define STREAM_AHEAD 2.5f
static float stVx, stVz, stPx, stPz; static unsigned stT; static int stInit, oldStream;   // oldStream: служебное сравнение со старым (1 клетка за кадр, 150/200 м)
static int stream(float x, float y, float z) {
  unsigned now = sceKernelGetSystemTimeLow();
  if (!stInit) { stInit = 1; stPx = x; stPz = z; stT = now; }
  float dt = (now - stT) * 1e-6f;
  if (dt > 0.f) {
    float vx = (x - stPx) / dt, vz = (z - stPz) / dt;
    if (vx * vx + vz * vz > 120.f * 120.f) vx = vz = 0.f;          // телепорт (goto, сброс) — не скорость
    float k = dt * 4.f; if (k > 1.f) k = 1.f;
    stVx += (vx - stVx) * k; stVz += (vz - stVz) * k;
  }
  stPx = x; stPz = z; stT = now;
  float ax = stVx * STREAM_AHEAD, az = stVz * STREAM_AHEAD, al = sqrtf(ax * ax + az * az);
  float loadD = oldStream ? 150.f : LOAD_DIST, dropD = oldStream ? 200.f : DROP_DIST; int qmax = oldStream ? 1 : LQ_N;
  if (oldStream) ax = az = 0.f;
  if (al > 90.f) { ax *= 90.f / al; az *= 90.f / al; }
  float px = x + ax, pz = z + az;
  short best[LQ_N]; float bs[LQ_N]; int nb = 0;
  for (unsigned i = 0; i < ncell; i++) {
    Cell *c = &cl[i]; if (c->owner) continue;
    float dx = c->cx - x, dy = c->cy - y, dz = c->cz - z, d2 = dx * dx + dy * dy + dz * dz;
    float qx = c->cx - px, qz = c->cz - pz, q2 = qx * qx + dy * dy + qz * qz;
    if (c->state >= 2) {
      float lim = dropD + c->rad;
      if (d2 > lim * lim && q2 > lim * lim) unloadCell(c);
    } else if (c->state == 0) {
      float lim = loadD + c->rad;
      if (d2 >= lim * lim && q2 >= lim * lim) continue;
      float d = sqrtf(d2) - c->rad, q = sqrtf(q2) - c->rad + 15.f, sc = d < q ? d : q;
      if (!oldStream && d < drawDist && visBox(c->bb, 0, 0, 0)) sc -= 60.f;   // уже должна быть видна — первой
      if (nb == qmax && sc >= bs[nb - 1]) continue;
      int j = nb < qmax ? nb++ : nb - 1;
      while (j > 0 && bs[j - 1] > sc) { bs[j] = bs[j - 1]; best[j] = best[j - 1]; j--; }
      bs[j] = sc; best[j] = (short)i;
    }
  }
  lqn = 0; __asm__ volatile("" ::: "memory");
  for (int k = 0; k < nb; k++) lq[k] = best[k];
  __asm__ volatile("" ::: "memory");
  lqn = nb;
  if (nb && !loaderBusy) sceKernelSignalSema(sema, 1);
  return nb > 0 || loaderBusy;
}
// служебное: сколько клеток города в кадре (ближе дальности видимости) ещё не загружено — это и есть «дыры»
static int stMissNow, stMissMax, stMissFrames, stFrames; static float stWorkSum, stWorkMax; static unsigned stRamMax;
static void streamMiss(void) {
  int m = 0;
  for (unsigned i = 0; i < ncell; i++) {
    Cell *c = &cl[i]; if (c->owner || c->state == 2) continue;
    if (boxD2(c->bb) < drawDist * drawDist && visBox(c->bb, 0, 0, 0)) m++;
  }
  stMissNow = m;
}
// цвет тумана = цвет горизонта самого неба уровня (как в GTA: туман = нижний цвет неба). Берём вершины
// кусков неба (owner 2) в полосе 0..6° над горизонтом (холмы/дымка за дальними домами) и 6..12° (низ неба),
// цвет = тексель x цвет вершины, вес = альфа. Раньше был постоянный голубой 0xe0b070 — ярче фона, дома за 60 м «светились».
static unsigned fogCol = SKY & 0xffffff; static int oldFog;
#define FOG_LOW_W .65f   // доля полосы 0..6° (остальное — 6..12°)
#define FOG_NEAR (longView ? .55f : .50f)   // туман с 50% дальности (дальний режим 55%: 138..250 м) до 100% на дальности отсечения: дом появляется уже растворённым
// служебное: файл streamlog рядом с EBOOT (число секунд) -> через столько секунд пишем stream.txt
static float stLogAt; static unsigned stT0;
static void streamStat(float work) {
  stFrames++; if (stMissNow) stMissFrames++; if (stMissNow > stMissMax) stMissMax = stMissNow;
  stWorkSum += work; if (work > stWorkMax) stWorkMax = work; if (loadedBytes > stRamMax) stRamMax = loadedBytes;
  if (!stT0) stT0 = sceKernelGetSystemTimeLow();
  if (stLogAt <= 0.f || (sceKernelGetSystemTimeLow() - stT0) * 1e-6f < stLogAt) return;
  stLogAt = 0.f;
  char fn[256], b[512]; sibling(fn, "stream.txt");
  int n = snprintf(b, sizeof b, "frames %d, frames with missing visible cells %d (%.1f%%), max missing %d\n"
    "work avg %.2f ms max %.2f ms; cells loaded %u, avg read %.1f ms; RAM cells max %.2f MB; heap used %.1f of %.1f MB; slowio %u KB/s\n"
    "fog color 0x%06x\n",
    stFrames, stMissFrames, 100.f * stMissFrames / (stFrames ? stFrames : 1), stMissMax, stWorkSum / (stFrames ? stFrames : 1), stWorkMax,
    stLoads, stLoads ? stLoadUs / 1000.f / stLoads : 0.f, stRamMax / 1048576.f, mallinfo().uordblks / 1048576.f, mallinfo().arena / 1048576.f, slowIoKBs, fogCol);
  SceUID f = sceIoOpen(fn, PSP_O_WRONLY | PSP_O_CREAT | PSP_O_TRUNC, 0777); if (f >= 0) { sceIoWrite(f, b, n); sceIoClose(f); }
}
// «радиальный» туман: GE считает туман по глубине кадра (z), а отсекаем мы по расстоянию (сфера 115 м) —
// у краёв кадра дом появлялся на 115 м, но по z это ~80 м и туман там был ~45%: видно, как он «выскакивает»,
// и туман менялся при повороте камеры. Для дальних кусков (> 50 м) масштабируем near/far тумана на cos угла
// до центра куска: туман ≈ f(расстояния), на границе отсечения — 100% в любом месте кадра. +1 команда GE на кусок.
static float fogK = -1.f;
static void fogBase(void) { fogK = 1.f; sceGuFog(drawDist * (oldFog ? .52f : FOG_NEAR), drawDist, fogCol); }
static void fogRadial(Piece *d, int far) {
  float k = 1.f;
  if (far && !oldFog) {
    float dx = d->cx - eyeX, dy = d->cy - eyeY, dz = d->cz - eyeZ, r = sqrtf(dx * dx + dy * dy + dz * dz);
    if (r > 1.f) { k = (dx * cfX + dy * cfY + dz * cfZ) / r; if (k < .35f) k = .35f; if (k > 1.f) k = 1.f; }
    k = floorf(k * 32.f + .5f) * (1.f / 32.f);
  }
  if (k == fogK) return; fogK = k;
  sceGuFog(drawDist * (oldFog ? .52f : FOG_NEAR) * k, drawDist * k, fogCol);
}
// служебное: файл flypath рядом с EBOOT (скорость м/с) — камера летит по кругу через весь уровень на высоте 3 м
// над землёй, машина стоит; нужно для замера стриминга без аварий автопилота
static float flyPathV, flyPathS; static int ground(float x, float z, float y, float step, float *out);
static void flyPathStep(float dt, float *ex, float *ey, float *ez, float *fx, float *fy, float *fz) {
  static const float W[][2] = {{220, 172}, {-300, 200}, {-300, -250}, {350, -150}, {350, -550}, {300, 500}, {-50, 550}, {220, 172}};
  const int nw = sizeof W / sizeof W[0]; float len = 0;
  for (int i = 0; i + 1 < nw; i++) len += hypotf(W[i + 1][0] - W[i][0], W[i + 1][1] - W[i][1]);
  flyPathS = fmodf(flyPathS + flyPathV * dt, len);
  float s = flyPathS;
  for (int i = 0; i + 1 < nw; i++) {
    float dx = W[i + 1][0] - W[i][0], dz = W[i + 1][1] - W[i][1], l = hypotf(dx, dz);
    if (s > l) { s -= l; continue; }
    float x = W[i][0] + dx * s / l, z = W[i][1] + dz * s / l, g = 0;
    if (!ground(x, z, 300.f, 0.f, &g)) g = *ey - 3.f;
    *ex = x; *ey = g + 3.f; *ez = z; *fx = dx / l; *fy = -.05f; *fz = dz / l;
    float n = sqrtf(*fx * *fx + *fy * *fy + *fz * *fz); *fx /= n; *fy /= n; *fz /= n; return;
  }
}
// ---- камера за машиной, как в оригинале: FollowCameraData (чанк 0x3000100) из art/cars/famil_v.p3d —
// rotation 180° (сзади), elevation 1.23 рад от вертикали, magnitude 7.2 м, target offset 0 (у bart_v/taxia/ccola…
// есть второй, дальний вариант index+256 с target (0, 0.5, 3)). Итого: 6.8 м позади, 2.4 м над целью.
// Опора камеры (точка машины) — пружина с критическим затуханием и упреждением по скорости машины: при любой
// скорости отставания нет (дистанция постоянна), а рывки положения (удары, неровный шаг физики) гасятся.
// Высота — своя, мягкая пружина с упреждением по сглаженной вертикальной скорости: подъём/спуск без отставания,
// дрожь колёс/кузова (2–5 Гц) не проходит, скорость камеры по вертикали ограничена. Поворот — пружина к курсу
// с пределом отставания. Всё точным решением (не зависит от частоты кадров).
#define CAM_MAG 7.2f
#define CAM_ELEV 1.23f
#define CAM_TGT_H 0.9f      // цель — середина кузова над началом машины (низ колёс)
#define CAM_LOOK_H 1.4f     // смотрим чуть выше цели: машина в нижней половине кадра, как было
typedef struct { int init; float ex, ez, ey, evx, evz, evy, vyLP, yaw, yawV, pull, lx, ly, lz, lvx, lvz, ay, lift, liftV; } ChaseCam;
static ChaseCam chase;
static void cdStep(float *e, float *ev, float w, float dt) {   // критическое затухание, точное решение за dt
  float x = *e, v = *ev, k = expf(-w * dt), c = v + w * x;
  *e = (x + c * dt) * k; *ev = (v - w * c * dt) * k;
}
static float wrapPi(float a) { while (a > 3.14159265f) a -= 6.2831853f; while (a < -3.14159265f) a += 6.2831853f; return a; }
static void chaseCamUpdate(const Car *c, float yawOfs, float dt, float cam[3], float look[3]) {
  ChaseCam *s = &chase;
  float ty = wrapPi(c->h + yawOfs);
  if (s->init && (fabsf(c->x - s->lx) > 8.f || fabsf(c->z - s->lz) > 8.f || fabsf(c->y - s->ly) > 8.f)) s->init = 0;   // телепорт
  if (!s->init) { memset(s, 0, sizeof *s); s->init = 1; s->yaw = ty; s->ay = c->y; }
  else if (dt > 0.f) {
    // опора по горизонтали = машина + ошибка e. Ожидаем, что машина сдвинется на скорость * dt (упреждение);
    // сдвинулась иначе (рывок, удар, неровный шаг физики) — разницу берёт ошибка и плавно гасит (10 рад/с)
    s->ex += s->lx + (s->lvx + c->vel[0]) * .5f * dt - c->x;
    s->ez += s->lz + (s->lvz + c->vel[2]) * .5f * dt - c->z;
    cdStep(&s->ex, &s->evx, 10.f, dt); cdStep(&s->ez, &s->evz, 10.f, dt);
    float l = sqrtf(s->ex * s->ex + s->ez * s->ez); if (l > 1.2f) { s->ex *= 1.2f / l; s->ez *= 1.2f / l; }
    // высота: упреждение — вертикальная скорость, сглаженная 0.35 с (склоны, трамплины без отставания);
    // подпрыгивания кузова/колёс и удары уходят в ошибку и гасятся мягко (5 рад/с)
    s->vyLP += (c->vel[1] - s->vyLP) * (1.f - expf(-dt / 0.35f));
    s->ey += s->ly + s->vyLP * dt - c->y;
    cdStep(&s->ey, &s->evy, 5.f, dt);
    if (s->ey > 2.f) s->ey = 2.f; if (s->ey < -2.f) s->ey = -2.f;
    float ay = c->y + s->ey, mv = (s->vyLP > 0.f ? 8.f : 14.f) * dt;   // скорость камеры по вертикали ограничена
    if (fabsf(s->vyLP) < 6.f) { if (ay > s->ay + mv) ay = s->ay + mv; if (ay < s->ay - mv) ay = s->ay - mv; s->ey = ay - c->y; }
    // поворот за курсом: без упреждения (в повороте видно бок машины, как в оригинале), отставание <= 0.5 рад
    float e = wrapPi(s->yaw - ty), ev = s->yawV; cdStep(&e, &ev, 6.f, dt);
    if (e > .5f) { e = .5f; if (ev > 0) ev = 0; } if (e < -.5f) { e = -.5f; if (ev < 0) ev = 0; }
    s->yaw = wrapPi(ty + e); s->yawV = ev;
    // на скорости чуть дальше (до +0.8 м), плавно
    float sp = sqrtf(c->vel[0] * c->vel[0] + c->vel[2] * c->vel[2]);
    s->pull += (fminf(sp * .025f, .8f) - s->pull) * (1.f - expf(-dt * 2.f));
  }
  s->lx = c->x; s->ly = c->y; s->lz = c->z; s->lvx = c->vel[0]; s->lvz = c->vel[2];
  float ax = c->x + s->ex, az = c->z + s->ez, ay = c->y + s->ey; s->ay = ay;
  float back = CAM_MAG * sinf(CAM_ELEV) + s->pull, up = CAM_MAG * cosf(CAM_ELEV);
  cam[0] = ax - sinf(s->yaw) * back; cam[2] = az - cosf(s->yaw) * back; cam[1] = ay + CAM_TGT_H + up;
  // не под землю на склоне: подъём над землёй плавный (жёсткий упор давал рывки картинки на перепадах)
  float g, need = 0.f; if (ground(cam[0], cam[2], cam[1] + 1.f, 0.f, &g) && cam[1] < g + .8f) need = g + .8f - cam[1];
  if (need > 1.2f) need = 1.2f;   // выше — крыша/стена за машиной, не лезем на неё
  { float e = s->lift - need; cdStep(&e, &s->liftV, 6.f, dt); s->lift = need + e; }
  cam[1] += s->lift;
  look[0] = ax; look[1] = ay + CAM_LOOK_H; look[2] = az;
}
static void skyFogColor(void) {
  float acc[2][4] = {{0}};
  for (int s = 0; s < nskyP; s++) {
    Piece *d = &pc[skyP[s]]; if (cl[d->r.cell].state != 2 || !d->v) continue;
    Tex *t = d->r.tex >= 0 && d->r.tex < (int)ntex ? &tex[d->r.tex] : 0;
    float k = d->r.sc / 32768.f;
    for (int i = 0; i < d->r.nv; i++) {
      Vert *v = &d->v[i];
      float px = v->x * k + d->r.ox, py = v->y * k + d->r.oy, pz = v->z * k + d->r.oz, hz = sqrtf(px * px + pz * pz);
      if (hz < 1e-3f) continue;
      float el = atanf(py / hz) * (180.f / GU_PI); int band = el >= 0.f && el < 6.f ? 0 : el >= 6.f && el < 12.f ? 1 : -1;
      if (band < 0) continue;
      float r = (v->c & 255) / 255.f, g = (v->c >> 8 & 255) / 255.f, b = (v->c >> 16 & 255) / 255.f, a = (v->c >> 24) / 255.f;
      if (t && t->lv[0]) {
        int tx = (int)floorf(v->u / 256.f * t->w) % t->w, ty = (int)floorf(v->v / 256.f * t->h) % t->h;
        if (tx < 0) tx += t->w; if (ty < 0) ty += t->h;
        unsigned c = ((unsigned *)t->pal)[((unsigned char *)t->lv[0])[ty * t->w + tx]];
        r *= (c & 255) / 255.f; g *= (c >> 8 & 255) / 255.f; b *= (c >> 16 & 255) / 255.f; a *= (c >> 24) / 255.f;
      }
      if (a < .25f) continue;
      acc[band][0] += r * a; acc[band][1] += g * a; acc[band][2] += b * a; acc[band][3] += a;
    }
  }
  if (acc[0][3] <= 0.f || acc[1][3] <= 0.f) return;   // неба нет — оставляем старый цвет
  unsigned out = 0;
  for (int ch = 0; ch < 3; ch++) {
    float f = FOG_LOW_W * acc[0][ch] / acc[0][3] + (1.f - FOG_LOW_W) * acc[1][ch] / acc[1][3];
    int q = (int)(f * 255.f + .5f); if (q > 255) q = 255;
    out |= (unsigned)q << (8 * ch);
  }
  fogCol = out;
}

// ---------- карта высот и стены ----------
static int ground(float x, float z, float y, float step, float *out) {
  int gx = (int)((x - hox) / hcell), gz = (int)((z - hoz) / hcell);
  if (gx < 0 || gz < 0 || gx >= hw || gz >= hh) return 0;
  short *c = hm + ((size_t)gz * hw + gx) * 4; int found = 0; float best = -1e9f;
  for (int i = 0; i < 4; i++) {
    if (c[i] == -32768) continue;
    float h = c[i] * .01f;
    if (h <= y + step && h > best) { best = h; found = 1; }
  }
  if (found) *out = best;
  return found;
}
// стена в клетке перекрывает высоты кузова машины?
static int wallAt(float x, float z, float y) {
  int gx = (int)((x - hox) / hcell), gz = (int)((z - hoz) / hcell);
  if (gx < 0 || gz < 0 || gx >= hw || gz >= hh) return 1;
  short *w = wl + ((size_t)gz * hw + gx) * 2;
  if (w[0] > w[1]) return 0;
  float lo = w[0] * .01f, hi = w[1] * .01f;
  return hi > y + 0.45f && lo < y + 1.6f;
}

// ---------- текстуры ----------
static int ilog2(int v) { return 31 - __builtin_clz(v); }
// swizzle: блоки 16 байт x 8 строк, как любит кэш текстур GE; высота добивается до кратной 8
static void swizzleLevel(unsigned char *out, const unsigned char *in, int w, int h) {
  int hp = (h + 7) & ~7, rb = w / 16;
  for (int j = 0; j < hp; j++) {
    const unsigned char *row = in + (j < h ? j : h - 1) * w;
    for (int bx = 0; bx < rb; bx++)
      memcpy(out + ((j >> 3) * rb + bx) * 128 + (j & 7) * 16, row + bx * 16, 16);
  }
}
static void swizzleAll(void) {
  for (unsigned i = 0; i < ntex; i++) {
    Tex *t = &tex[i]; size_t sz = 0; int lw = t->w, lh = t->h;
    for (int l = 0; l < t->levels; l++) { sz += (size_t)lw * ((lh + 7) & ~7); lw >>= 1; lh = lh > 1 ? lh >> 1 : 1; }
    unsigned char *b = memalign(16, sz); if (!b) return;           // нет памяти — останемся на линейных
    lw = t->w; lh = t->h;
    for (int l = 0; l < t->levels; l++) {
      t->slv[l] = b; swizzleLevel(b, t->lv[l], lw, lh);
      b += (size_t)lw * ((lh + 7) & ~7); lw >>= 1; lh = lh > 1 ? lh >> 1 : 1;
    }
  }
}

// ---------- состояние GE: шлём только то, что поменялось ----------
static int bound, texOn, curFlags, curFilt, binds;
static void resetState(void) { bound = -2; texOn = -1; curFlags = -1; curFilt = -1; }
static void texEnable(int on) {
  if (on == texOn) return; texOn = on;
  if (on) sceGuEnable(GU_TEXTURE_2D); else sceGuDisable(GU_TEXTURE_2D);
}
static void bindTexLean(int t) {
  if (!(opt & O_TEX)) t = -1;
  if (t == bound) return; bound = t;
  if (t < 0 || t >= (int)ntex) { texEnable(0); return; }
  texEnable(1); binds++;
  Tex *x = &tex[t]; int swz = (opt & O_SWZ) && x->slv[0];
  unsigned p = (unsigned)x->pal;
  sceGuSendCommandi(0xb0, p & 0xffffff); sceGuSendCommandi(0xb1, (p >> 8) & 0xf0000); sceGuSendCommandi(0xc4, 32);
  sceGuSendCommandi(0xc2, ((x->levels - 1) << 16) | swz);       // TEX_MODE: уровни, swizzle
  sceGuSendCommandi(0xc3, GU_PSM_T8);                            // TEX_FORMAT
  int lw = x->w, lh = x->h;
  for (int l = 0; l < x->levels; l++) {
    unsigned a = (unsigned)(swz ? x->slv[l] : x->lv[l]);
    sceGuSendCommandi(0xa0 + l, a & 0xffffff);
    sceGuSendCommandi(0xa8 + l, ((a >> 8) & 0x0f0000) | lw);
    sceGuSendCommandi(0xb8 + l, (ilog2(lh) << 8) | ilog2(lw));
    lw >>= 1; lh = lh > 1 ? lh >> 1 : 1;
  }
  sceGuSendCommandi(0xcb, 0);                                    // один TEX_FLUSH на привязку
  int f = x->levels > 1 ? ((opt & O_TRI) ? GU_LINEAR_MIPMAP_LINEAR : GU_LINEAR_MIPMAP_NEAREST) : GU_LINEAR;
  if (f != curFilt) { curFilt = f; sceGuTexFilter(f, GU_LINEAR); }
}
static void setFlags(int fl) {
  fl &= 7; if (fl == curFlags) return; curFlags = fl;
  if (fl & 1) sceGuEnable(GU_ALPHA_TEST); else sceGuDisable(GU_ALPHA_TEST);
  if (fl & 2) sceGuEnable(GU_BLEND); else sceGuDisable(GU_BLEND);
  sceGuDepthMask((fl & 6) ? GU_TRUE : GU_FALSE);                 // прозрачное и небо глубину не пишут
}
// старый путь v7 (для сравнения в тесте: вариант LEGACY)
static void bindTexLegacy(int t) {
  if (!(opt & O_TEX)) t = -1;
  if (t == bound) return; bound = t;
  if (t < 0 || t >= (int)ntex) { sceGuDisable(GU_TEXTURE_2D); texOn = 0; return; }
  Tex *x = &tex[t]; int swz = (opt & O_SWZ) && x->slv[0]; binds++;
  sceGuEnable(GU_TEXTURE_2D); texOn = 1;
  sceGuClutMode(GU_PSM_8888, 0, 0xff, 0); sceGuClutLoad(32, x->pal);
  sceGuTexMode(GU_PSM_T8, x->levels - 1, 0, swz);
  int lw = x->w, lh = x->h;
  for (int l = 0; l < x->levels; l++) { sceGuTexImage(l, lw, lh, lw, swz ? x->slv[l] : x->lv[l]); lw >>= 1; lh = lh > 1 ? lh >> 1 : 1; }
  sceGuTexLevelMode(GU_TEXTURE_AUTO, 0.f);
  sceGuTexFilter(x->levels > 1 ? ((opt & O_TRI) ? GU_LINEAR_MIPMAP_LINEAR : GU_LINEAR_MIPMAP_NEAREST) : GU_LINEAR, GU_LINEAR);
  sceGuTexOffset(0.f, 0.f); curFilt = -1;
}

// ---------- отрисовка кусков ----------
static long drawnTris; static int draws;
static void drawIdx(Piece *d, unsigned short *ix, int cnt) {
  for (int k = 0; k < cnt; k += 65532) {
    int n = cnt - k; if (n > 65532) n = 65532;
    sceGuDrawArray(GU_TRIANGLES, GU_INDEX_16BIT | GU_TEXTURE_16BIT | GU_COLOR_8888 | GU_VERTEX_16BIT | GU_TRANSFORM_3D,
                   n, ix + k, d->v);
  }
}
// Полупрозрачное (стекло, тени-пятна, листва с blend): пока tqOn, куски с флагом 2 не рисуются сразу, а
// откладываются в очередь и рисуются одним проходом после всего непрозрачного (город, машина, пропы, монеты),
// от дальнего к ближнему, с тестом глубины и без записи. Иначе стекло без записи глубины затирается тем, что
// рисуется после него (машина за витриной оказывалась поверх стекла), а стёкла друг за другом — в порядке текстур.
#define MAXTQ 256
typedef struct { Piece p; ScePspFMatrix4 m; unsigned short *ix; int cnt; float key; } TQ;
static TQ tq[MAXTQ]; static TQ *tqp[MAXTQ]; static int ntq, tqOn; static float tqEx, tqEy, tqEz;
static int tqPush(const Piece *d, const ScePspFMatrix4 *m, unsigned short *ix, int cnt, float cx, float cy, float cz) {
  if (!tqOn || !(d->r.flags & 2) || (d->r.flags & 4) || ntq >= MAXTQ) return 0;
  TQ *q = &tq[ntq++]; q->p = *d; q->m = *m; q->ix = ix; q->cnt = cnt;
  float dx = cx - tqEx, dy = cy - tqEy, dz = cz - tqEz; q->key = dx * dx + dy * dy + dz * dz;
  return 1;
}
// мир = T + R(угол) * (центр куска + масштаб * вершина); матрица модели сразу в GE, без стека gum
static void drawPiece(Piece *d, int far, float tx, float ty, float tz, float c, float s) {
  unsigned short *ix = far ? d->fidx : d->idx; int cnt = far ? (int)d->r.nf : d->r.ni;
  if (cnt <= 0) return;
  float k = d->r.sc, ox = d->r.ox, oy = d->r.oy, oz = d->r.oz;
  ScePspFMatrix4 m = {
    {c * k, 0, -s * k, 0}, {0, k, 0, 0}, {s * k, 0, c * k, 0},
    {tx + c * ox + s * oz, ty + oy, tz - s * ox + c * oz, 1}};
  if (tqPush(d, &m, ix, cnt, (d->r.bb[0] + d->r.bb[3]) * .5f + tx, (d->r.bb[1] + d->r.bb[4]) * .5f + ty, (d->r.bb[2] + d->r.bb[5]) * .5f + tz)) return;
  drawnTris += cnt / 3; draws++;
  bindTexLean(d->r.tex); setFlags(d->r.flags);
  sceGuSetMatrix(GU_MODEL, &m);
  drawIdx(d, ix, cnt);
}
static void drawPieceM(Piece *d, const ScePspFMatrix4 *m) {   // кусок с готовой матрицей модели
  if (d->r.ni <= 0) return;
  if (tqPush(d, m, d->idx, d->r.ni, m->w.x, m->w.y, m->w.z)) return;
  drawnTris += d->r.ni / 3; draws++;
  bindTexLean(d->r.tex); setFlags(d->r.flags);
  sceGuSetMatrix(GU_MODEL, m);
  drawIdx(d, d->idx, d->r.ni);
}
static int tqCmp(const void *a, const void *b) {   // дальние раньше
  float ka = (*(TQ *const *)a)->key, kb = (*(TQ *const *)b)->key; return ka < kb ? 1 : ka > kb ? -1 : 0;
}
static void tqFlush(void) {
  tqOn = 0;
  for (int i = 0; i < ntq; i++) tqp[i] = &tq[i];
  qsort(tqp, ntq, sizeof *tqp, tqCmp);
  for (int i = 0; i < ntq; i++) {
    TQ *q = tqp[i]; drawnTris += q->cnt / 3; draws++;
    bindTexLean(q->p.r.tex); setFlags(q->p.r.flags);
    sceGuSetMatrix(GU_MODEL, &q->m);
    drawIdx(&q->p, q->ix, q->cnt);
  }
  ntq = 0;
}
static void drawPieceLegacy(Piece *d, int far) {
  unsigned short *ix = far ? d->fidx : d->idx; int cnt = far ? (int)d->r.nf : d->r.ni;
  if (cnt <= 0) return; drawnTris += cnt / 3; draws++;
  bindTexLegacy(d->r.tex); sceGuTexScale(128.f, 128.f);
  if (d->r.flags & 1) sceGuEnable(GU_ALPHA_TEST); else sceGuDisable(GU_ALPHA_TEST);
  if (d->r.flags & 2) { sceGuEnable(GU_BLEND); sceGuDepthMask(GU_TRUE); }
  else { sceGuDisable(GU_BLEND); sceGuDepthMask(GU_FALSE); }
  curFlags = -1;
  sceGumPushMatrix();
  ScePspFVector3 o = {d->r.ox, d->r.oy, d->r.oz}, sv = {d->r.sc, d->r.sc, d->r.sc};
  sceGumTranslate(&o); sceGumScale(&sv);
  for (int k = 0; k < cnt; k += 65532) {
    int n = cnt - k; if (n > 65532) n = 65532;
    sceGumDrawArray(GU_TRIANGLES, GU_INDEX_16BIT | GU_TEXTURE_16BIT | GU_COLOR_8888 | GU_VERTEX_16BIT | GU_TRANSFORM_3D,
                    n, ix + k, d->v);
  }
  sceGumPopMatrix();
}

// ---------- отсечение ----------
static float pl[4][3], eyeX, eyeY, eyeZ, cfX, cfY, cfZ, drawDist;
static void setupPlanes(float fx, float fy, float fz) {
  float rx = -fz, rz = fx, rl = sqrtf(rx * rx + rz * rz); if (rl < 1e-4f) { rx = 1; rz = 0; rl = 1; }
  rx /= rl; rz /= rl;                                   // вправо = взгляд x вверх
  float ux = -rz * fy, uy = rz * fx - rx * fz, uz = rx * fy;   // вверх камеры = вправо x взгляд
  float tv = tanf(FOVY * .5f * GU_PI / 180.f) * 1.03f, th = tv * ASPECT;
  float n[4][3] = {
    {fx * th - rx, fy * th, fz * th - rz}, {fx * th + rx, fy * th, fz * th + rz},
    {fx * tv - ux, fy * tv - uy, fz * tv - uz}, {fx * tv + ux, fy * tv + uy, fz * tv + uz}};
  memcpy(pl, n, sizeof pl);
}
// ящик целиком снаружи одной из 4 боковых плоскостей? (ox,oy,oz — сдвиг ящика, для неба = глаз)
static int visBox(const float *b, float ox, float oy, float oz) {
  for (int i = 0; i < 4; i++) {
    float px = (pl[i][0] > 0 ? b[3] : b[0]) + ox - eyeX;
    float py = (pl[i][1] > 0 ? b[4] : b[1]) + oy - eyeY;
    float pz = (pl[i][2] > 0 ? b[5] : b[2]) + oz - eyeZ;
    if (px * pl[i][0] + py * pl[i][1] + pz * pl[i][2] < 0) return 0;
  }
  return 1;
}
static float boxD2(const float *b) {
  float dx = b[0] - eyeX > 0 ? b[0] - eyeX : (eyeX - b[3] > 0 ? eyeX - b[3] : 0);
  float dy = b[1] - eyeY > 0 ? b[1] - eyeY : (eyeY - b[4] > 0 ? eyeY - b[4] : 0);
  float dz = b[2] - eyeZ > 0 ? b[2] - eyeZ : (eyeZ - b[5] > 0 ? eyeZ - b[5] : 0);
  return dx * dx + dy * dy + dz * dz;
}
static int coneOut(float cx, float cy, float cz, float rad, float *dist) {   // старое отсечение v7
  float dx = cx - eyeX, dy = cy - eyeY, dz = cz - eyeZ, d2 = dx * dx + dy * dy + dz * dz, d = sqrtf(d2);
  *dist = d - rad; if (d - rad > drawDist) return 1;
  float f = dx * cfX + dy * cfY + dz * cfZ, l = sqrtf(fmaxf(0.f, d2 - f * f));
  return l * CONE_COS - f * CONE_SIN > rad;
}

#define MAXDRAW 2048
static unsigned short tk[MAXDRAW], tp[MAXDRAW], sp[MAXDRAW], cnt2k[2048]; static unsigned char tf[MAXDRAW], sf[MAXDRAW];
static int nd;
static void cullPiece(unsigned k) {
  Piece *d = &pc[k]; int far;
  if (opt & O_PLANES) {
    float d2 = boxD2(d->r.bb);
    if (d2 > drawDist * drawDist || !visBox(d->r.bb, 0, 0, 0)) return;
    far = d2 > LOD_DIST * LOD_DIST;
  } else {
    float dist; if (coneOut(d->cx, d->cy, d->cz, d->rad, &dist)) return;
    far = dist > LOD_DIST;
  }
  if (!(opt & O_FAR)) far = 0;
  if (nd >= MAXDRAW) return;
  int t = d->r.tex < 0 || d->r.tex > 510 ? 511 : d->r.tex;
  tk[nd] = ((d->r.flags & 3) << 9) | t; tp[nd] = k; tf[nd] = far; nd++;
}
static int pvsList(float x, float z, unsigned short **out) {
  if (!pvsEnt) return -1;
  int gx = (int)floorf((x - pvsOx) / pvsCell), gz = (int)floorf((z - pvsOz) / pvsCell);
  if (gx < 0 || gz < 0 || gx >= pvsW || gz >= pvsH) return -1;
  unsigned *e = pvsEnt + 2 * (gz * pvsW + gx);
  if (e[1] == 0xFFFFFFFFu) return -1;
  *out = pvsPool + e[0]; return (int)e[1];
}
static int pvsUsed;
static void cullCity(int fly) {
  nd = 0; pvsUsed = 0;
  unsigned short *pl_; int n = (opt & O_PVS) && !fly ? pvsList(eyeX, eyeZ, &pl_) : -1;
  if (n >= 0) {                                        // PVS: только куски, видимые из этой клетки 20x20 м
    pvsUsed = 1;
    float pr2 = drawDist > PVS_RANGE ? PVS_RANGE * PVS_RANGE : 1e30f;   // дальний режим: из PVS только до 115 м
    for (int i = 0; i < n; i++) { unsigned k = pl_[i]; if (k < npc && cl[pc[k].r.cell].state == 2 && boxD2(pc[k].r.bb) <= pr2) cullPiece(k); }
    if (drawDist > PVS_RANGE)                            // за 115 м PVS нет: клетки по пирамиде, куски дальше 115 м (без двойников)
      for (unsigned i = 0; i < ncell; i++) {
        Cell *c = &cl[i]; if (c->owner || c->state != 2) continue;
        if (boxD2(c->bb) > drawDist * drawDist || !visBox(c->bb, 0, 0, 0)) continue;
        for (unsigned k = c->first; k < c->first + c->n; k++) if (boxD2(pc[k].r.bb) > pr2) cullPiece(k);
      }
  } else {
    for (unsigned i = 0; i < ncell; i++) {
      Cell *c = &cl[i]; if (c->owner || c->state != 2) continue;
      if (opt & O_PLANES) { if (boxD2(c->bb) > drawDist * drawDist || !visBox(c->bb, 0, 0, 0)) continue; }
      else { float dist; if (coneOut(c->cx, c->cy, c->cz, c->rad, &dist)) continue; }
      for (unsigned k = c->first; k < c->first + c->n; k++) cullPiece(k);
    }
  }
  // сортировка подсчётом по (прозрачность, текстура): меньше смен текстур, прозрачное после непрозрачного
  memset(cnt2k, 0, sizeof cnt2k);
  for (int i = 0; i < nd; i++) cnt2k[tk[i]]++;
  unsigned s = 0; for (int k = 0; k < 2048; k++) { unsigned c = cnt2k[k]; cnt2k[k] = s; s += c; }
  for (int i = 0; i < nd; i++) { int p = cnt2k[tk[i]]++; sp[p] = tp[i]; sf[p] = tf[i]; }
}

// ---------- тест-прогон v2 ----------
// P1: весь уровень (как v1: 169 точек x 4 направления), P2: 16 худших видов x варианты-переключатели,
// P3: 8 худших видов с настоящей вертикальной синхронизацией, считаем пропущенные кадры. Отчёт bench.txt.
#define MAXBP 1024
#define NW2 16
#define NW3 8
static const struct { const char *name; unsigned set, clr; } VAR[] = {
  {"BASE", 0, 0}, {"NOSWZ", 0, O_SWZ}, {"NOTEX", 0, O_TEX}, {"BILIN", 0, O_TRI}, {"NOPVS", 0, O_PVS},
  {"CONE", 0, O_PLANES}, {"LEGACY", 0, O_LEAN}, {"ALLNEAR", 0, O_FAR}, {"NOSKY", 0, O_SKY},
  {"NOSKYCULL", 0, O_SKYCULL}, {"QVP", O_QVP, 0}, {"D100", O_D100, 0}, {"NOHUD", 0, O_HUD},
  {"FAST", O_D100, O_TRI},
};
#define NVAR ((int)(sizeof VAR / sizeof VAR[0]))
static float bpx[MAXBP], bpy[MAXBP], bpz[MAXBP]; static int nbp;
static float p1w[MAXBP * 4], p1all[MAXBP * 8]; static int p1n;
static double p1cpu, p1tris, p1draws; static float p1cpuMax; static int p1trisMax, p1drawsMax, p1pvs;
static int w2[NW2], nw2, w3[NW3], nw3;
static float p2res[NW2][NVAR], p2tri[NVAR], p2drw[NVAR], bm[3]; static int bmn;
static int p3miss[NW3], p3missAll; static float p3max; static unsigned lastVc;
static int bpass, bview, bsub, bvar, bwait, bwaitIdle, bVsync, bMeasure; static unsigned bwaitT0;
static char brep[4][64];
// проверка PVS (служебный файл pvscheck): каждый вид рисуем с PVS и без и сравниваем пиксели
static unsigned *fbA, *curFb; static int pcDiff[MAXBP * 4];
static void pvscheckWrite(void) {
  char fn[256]; sibling(fn, "pvscheck.txt");
  SceUID f = sceIoOpen(fn, PSP_O_WRONLY | PSP_O_CREAT | PSP_O_TRUNC, 0777); if (f < 0) return;
  static char b[4096]; int n = 0, nv = nbp * 4, bad = 0, over100 = 0; long tot = 0;
  for (int v = 0; v < nv; v++) { if (pcDiff[v]) bad++; if (pcDiff[v] > 100) over100++; tot += pcDiff[v]; }
  n += snprintf(b + n, sizeof b - n, "PVSCHECK %d views: with diff %d, diff>100px %d, total diff px %ld, pvs %s\nworst (x z heading px):\n",
                nv, bad, over100, tot, pvsEnt ? "yes" : "no");
  for (int k = 0; k < 25; k++) {
    int bi = -1; for (int v = 0; v < nv; v++) if (pcDiff[v] > 0 && (bi < 0 || pcDiff[v] > pcDiff[bi])) bi = v;
    if (bi < 0) break;
    n += snprintf(b + n, sizeof b - n, "   %.1f %.1f %d %d\n", bpx[bi / 4], bpz[bi / 4], bi % 4, pcDiff[bi]); pcDiff[bi] = -pcDiff[bi];
  }
  for (int v = 0; v < nv; v++) if (pcDiff[v] < 0) pcDiff[v] = -pcDiff[v];
  sceIoWrite(f, b, n); sceIoClose(f);
}

static void benchPoints(void) {
  int st = (int)(50.f / hcell); nbp = 0;
  for (int gz = st / 2, row = 0; gz < hh; gz += st, row++)
    for (int j = 0; j < hw / st + 1; j++) {
      int gx = st / 2 + (row & 1 ? (hw / st - j) : j) * st;
      if (gx < 0 || gx >= hw || nbp >= MAXBP) continue;
      short *c = hm + ((size_t)gz * hw + gx) * 4; int lo = 32767;
      for (int i = 0; i < 4; i++) if (c[i] != -32768 && c[i] < lo) lo = c[i];
      if (lo == 32767) continue;
      bpx[nbp] = hox + (gx + .5f) * hcell; bpz[nbp] = hoz + (gz + .5f) * hcell; bpy[nbp] = lo * .01f; nbp++;
    }
}
static int curView(void) { return bpass == 1 || bpass == 5 ? bview : bpass == 2 ? w2[bview] : w3[bview]; }
static void teleport(void) { bwait = 1; bwaitIdle = 0; bwaitT0 = sceKernelGetSystemTimeLow(); bsub = 0; }
static int cmpF(const void *a, const void *b) { float x = *(const float *)a, y = *(const float *)b; return x < y ? -1 : x > y; }
static void pickWorst(int *out, int n, int *nout) {    // n худших видов P1, по порядку обхода
  *nout = 0;
  for (int k = 0; k < n; k++) {
    int bi = -1;
    for (int v = 0; v < nbp * 4; v++) {
      int used = 0; for (int j = 0; j < *nout; j++) if (out[j] == v) used = 1;
      if (!used && (bi < 0 || p1w[v] > p1w[bi])) bi = v;
    }
    if (bi < 0) break; out[(*nout)++] = bi;
  }
  for (int i = 1; i < *nout; i++) for (int j = i; j > 0 && out[j] < out[j - 1]; j--) { int t = out[j]; out[j] = out[j - 1]; out[j - 1] = t; }
}
static void benchWrite(void) {
  char fn[256]; sibling(fn, "bench.txt");
  SceUID f = sceIoOpen(fn, PSP_O_WRONLY | PSP_O_CREAT | PSP_O_TRUNC, 0777); if (f < 0) return;
  static char b[8192]; int n = 0;
  n += snprintf(b + n, sizeof b - n, "BENCH2 v8 (%s %s)  opt %03x  pvs %s  view %.0f m\n", __DATE__, __TIME__, O_DEFAULT, pvsEnt ? "yes" : "no", longView ? DIST_LONG : DIST_SHORT);
  if (p1n) {
    static float s[MAXBP * 8]; memcpy(s, p1all, p1n * sizeof(float)); qsort(s, p1n, sizeof(float), cmpF);
    double sum = 0; int over = 0; for (int i = 0; i < p1n; i++) { sum += s[i]; if (s[i] > 16.7f) over++; }
    n += snprintf(b + n, sizeof b - n,
      "P1 %d views, %d frames: work avg %.2f p50 %.2f p90 %.2f p99 %.2f max %.2f ms; over 16.7ms %.1f%%\n"
      "   cpu avg %.2f max %.2f ms; tris avg %.1fk max %.1fk; draws avg %.0f max %d; pvs used %d%%\n"
      "   (v7: avg 16.8, worst 25.0, over 55.2%%)\n",
      nbp * 4, p1n, sum / p1n, s[p1n / 2], s[p1n * 9 / 10], s[p1n * 99 / 100], s[p1n - 1], 100.f * over / p1n,
      p1cpu / p1n, p1cpuMax, p1tris / p1n / 1000., p1trisMax / 1000.f, p1draws / p1n, p1drawsMax, 100 * p1pvs / p1n);
  }
  if (bpass >= 3 || (bpass == 0 && nw2)) {
    n += snprintf(b + n, sizeof b - n, "P2 %d worst views, median of 3 frames, no vsync:\n   variant     ms   delta   tris  draws\n", nw2);
    float base = 0; for (int v = 0; v < nw2; v++) base += p2res[v][0]; base /= nw2 ? nw2 : 1;
    for (int k = 0; k < NVAR; k++) {
      float m = 0; for (int v = 0; v < nw2; v++) m += p2res[v][k]; m /= nw2 ? nw2 : 1;
      n += snprintf(b + n, sizeof b - n, "   %-10s %5.2f %+6.2f %5.1fk %5.0f\n", VAR[k].name, m, m - base,
                    p2tri[k] / (nw2 * 3) / 1000.f, p2drw[k] / (nw2 * 3));
    }
  }
  if (bpass == 0 && nw3) {
    n += snprintf(b + n, sizeof b - n, "P3 vsync, %d worst views x 60 frames: missed vblanks total %d (", nw3, p3missAll);
    for (int i = 0; i < nw3; i++) n += snprintf(b + n, sizeof b - n, "%d%s", p3miss[i], i + 1 < nw3 ? " " : "");
    n += snprintf(b + n, sizeof b - n, "), worst work %.2f ms\n", p3max);
  }
  if (p1n) {
    n += snprintf(b + n, sizeof b - n, "worst P1 views (x z heading work):\n");
    for (int i = 0; i < nw2 && n < (int)sizeof b - 80; i++) {
      int v = w2[i]; n += snprintf(b + n, sizeof b - n, "   %.0f %.0f %d %.2f\n", bpx[v / 4], bpz[v / 4], v % 4, p1w[v]);
    }
  }
  sceIoWrite(f, b, n); sceIoClose(f);
}
static void benchStart(void) {
  benchPoints(); bpass = 1; bview = 0; p1n = 0; p1cpu = p1tris = p1draws = 0; p1cpuMax = 0; p1trisMax = p1drawsMax = p1pvs = 0;
  memset(p1w, 0, sizeof p1w); memset(p2res, 0, sizeof p2res); memset(p2tri, 0, sizeof p2tri); memset(p2drw, 0, sizeof p2drw);
  nw2 = nw3 = 0; p3missAll = 0; p3max = 0; memset(p3miss, 0, sizeof p3miss); bvar = 0; bmn = 0;
  teleport();
}
// перед кадром: куда смотрим, какие переключатели, меряем ли этот кадр
static void benchBefore(int pending, float sph, float *x, float *y, float *z, float *h) {
  int v = curView();
  *x = bpx[v / 4]; *y = bpy[v / 4]; *z = bpz[v / 4]; *h = sph + (v % 4) * GU_PI * .5f;
  opt = O_DEFAULT; bMeasure = 0; bVsync = bpass == 3;
  if (bwait) {
    if (!pending) bwaitIdle++; else bwaitIdle = 0;
    if (bwaitIdle >= 2 || sceKernelGetSystemTimeLow() - bwaitT0 > 5000000) bwait = 0;
    else { sceKernelDelayThread(2000); return; }        // ждём загрузку клеток, отдаём время загрузчику
  }
  if (bpass == 1) bMeasure = bsub >= 2;
  else if (bpass == 2) { opt = (O_DEFAULT | VAR[bvar].set) & ~VAR[bvar].clr; bMeasure = bsub >= 2; }
  else if (bpass == 3) bMeasure = bsub >= 2;
  else if (bpass == 5) { opt = O_DEFAULT & ~O_HUD & ~(bsub == 1 ? O_PVS : 0); bMeasure = 1; }
}
// после кадра: записать замер, сдвинуть состояние
static void benchAfter(float work, float cpu, int missed) {
  if (bwait) return;
  int v = curView();
  if (bpass == 5) {
    unsigned *fb = (unsigned *)((unsigned)curFb | 0x40000000);
    if (bsub == 0) memcpy(fbA, fb, BUF_W * SCR_H * 4);
    else {
      int d = 0;
      for (int yy = 0; yy < SCR_H; yy++) for (int xx = 0; xx < SCR_W; xx++) {
        unsigned a = fbA[yy * BUF_W + xx], c = fb[yy * BUF_W + xx];
        int e = abs((int)(a & 255) - (int)(c & 255)) + abs((int)((a >> 8) & 255) - (int)((c >> 8) & 255)) + abs((int)((a >> 16) & 255) - (int)((c >> 16) & 255));
        if (e > 48) d++;
      }
      pcDiff[v] = d;
    }
    if (++bsub >= 2) {
      bsub = 0;
      if (++bview >= nbp * 4) { bpass = 0; pvscheckWrite(); snprintf(brep[0], 64, "PVSCHECK done"); snprintf(brep[1], 64, "pvscheck.txt"); }
      else if (bview % 4 == 0) teleport();
    }
    return;
  }
  if (bpass == 1) {
    if (bMeasure) {
      if (p1n < MAXBP * 8) p1all[p1n++] = work;
      if (work > p1w[v]) p1w[v] = work;
      p1cpu += cpu; if (cpu > p1cpuMax) p1cpuMax = cpu;
      p1tris += drawnTris; if (drawnTris > p1trisMax) p1trisMax = drawnTris;
      p1draws += draws; if (draws > p1drawsMax) p1drawsMax = draws; p1pvs += pvsUsed;
    }
    if (++bsub >= 4) {
      bsub = 0;
      if (++bview >= nbp * 4) {
        pickWorst(w2, NW2, &nw2); benchWrite();
        bpass = 2; bview = 0; bvar = 0; bmn = 0; teleport();
      } else if (bview % 4 == 0) teleport();
    }
  } else if (bpass == 2) {
    if (bMeasure) { bm[bmn++] = work; p2tri[bvar] += drawnTris; p2drw[bvar] += draws; }
    if (++bsub >= 5) {
      qsort(bm, bmn, sizeof(float), cmpF); p2res[bview][bvar] = bm[bmn / 2]; bmn = 0; bsub = 0;
      if (++bvar >= NVAR) {
        bvar = 0;
        if (++bview >= nw2) {
          pickWorst(w3, NW3, &nw3); benchWrite();
          bpass = 3; bview = 0; teleport();
        } else teleport();
      }
    }
  } else if (bpass == 3) {
    if (bMeasure) { if (missed) { p3miss[bview]++; p3missAll++; } if (work > p3max) p3max = work; }
    if (++bsub >= 62) {
      if (++bview >= nw3) {
        bpass = 0; benchWrite();
        snprintf(brep[0], 64, "BENCH v2 done. vsync misses: %d", p3missAll);
        snprintf(brep[1], 64, "report: bench.txt   O: close");
        brep[2][0] = 0;
      } else teleport();
    }
  }
}

int main(int argc, char **argv) {
  int th = sceKernelCreateThread("cb", cbThread, 0x11, 0xFA0, 0, 0);
  if (th >= 0) sceKernelStartThread(th, 0, 0);
  scePowerSetClockFrequency(333, 333, 166);
  pspDebugScreenInit(); pspDebugScreenPrintf("Loading Springfield...\n");

  strncpy(path, argv[0], sizeof(path) - 16); path[sizeof(path) - 16] = 0;
  char *slash = strrchr(path, '/'); if (slash) slash[1] = 0; else path[0] = 0;
  strcat(path, "level.shr");

  // резидентная часть: заголовок, карта высот, текстуры, таблицы кусков и клеток, PVS
  SceUID fd = sceIoOpen(path, PSP_O_RDONLY, 0);
  if (fd < 0) fail("level.shr not found next to EBOOT.PBP.");
  unsigned char hdr[104];   // заголовок SHR7 104 Б (@100 — смещение CAR1)
  if (sceIoRead(fd, hdr, 104) != 104 || memcmp(hdr, "SHR7", 4)) fail("level.shr is an old version. Run the export again.");
  ntex = *(unsigned *)(hdr + 4); npc = *(unsigned *)(hdr + 8);
  float *hd = (float *)(hdr + 12);
  float spx = hd[6], spy = hd[7], spz = hd[8], sph = hd[9], lift = hd[10];
  hox = hd[11]; hoz = hd[12]; hcell = hd[13]; hw = *(int *)(hd + 14); hh = *(int *)(hd + 15);
  unsigned tableOff = *(unsigned *)(hdr + 76);
  ncell = *(unsigned *)(hdr + 80); unsigned cellOff = *(unsigned *)(hdr + 84), pvsOff = *(unsigned *)(hdr + 88);
  unsigned residentSize = cellOff + 48 * ncell;
  unsigned char *data = memalign(16, residentSize);
  if (!data) {
    char m[160]; snprintf(m, sizeof m, "Not enough memory: %.1f MB needed, %.1f MB free.",
      residentSize / 1048576.f, sceKernelMaxFreeMemSize() / 1048576.f); fail(m);
  }
  sceIoLseek32(fd, 0, PSP_SEEK_SET);
  if (sceIoRead(fd, data, residentSize) != (int)residentSize) fail("Read error.");
  if (pvsOff) {
    unsigned char ph[32];
    sceIoLseek32(fd, pvsOff, PSP_SEEK_SET);
    if (sceIoRead(fd, ph, 32) == 32 && !memcmp(ph, "PVS1", 4)) {
      float *pf = (float *)(ph + 4); unsigned *pu = (unsigned *)(ph + 16);
      pvsOx = pf[0]; pvsOz = pf[1]; pvsCell = pf[2]; pvsW = pu[0]; pvsH = pu[1];
      unsigned sz = pvsW * pvsH * 8 + pu[2] * 2;
      void *m = memalign(16, sz);
      if (m && sceIoRead(fd, m, sz) == (int)sz) { pvsEnt = m; pvsPool = (unsigned short *)((char *)m + pvsW * pvsH * 8); }
      else if (m) free(m);
    }
  }
  unsigned propOff = *(unsigned *)(hdr + 96);
  { unsigned colOff = *(unsigned *)(hdr + 92);
    if (colOff) {
      // граница COL1 — следующая секция по файлу (PVS1 и/или PRP1, какая ближе), иначе конец файла
      unsigned end = 0;
      if (pvsOff && (!end || pvsOff < end)) end = pvsOff;
      if (propOff && (!end || propOff < end)) end = propOff;
      if (!end) end = (unsigned)sceIoLseek32(fd, 0, PSP_SEEK_END);
      unsigned sz = end - colOff; void *m = memalign(16, sz);
      sceIoLseek32(fd, colOff, PSP_SEEK_SET);
      if (m && sceIoRead(fd, m, sz) == (int)sz && colInit(&world, m, sz) == 0) haveCol = 1;
      else if (m) free(m);
    } }
  if (propOff) {
    unsigned char ph[64];
    sceIoLseek32(fd, propOff, PSP_SEEK_SET);
    int pn = sceIoRead(fd, ph, 64);
    if (pn >= 32 && (!memcmp(ph, "PRP1", 4) || (pn == 64 && !memcmp(ph, "PRP2", 4)))) {
      unsigned *pu = (unsigned *)(ph + 4);
      unsigned sz = 32 + pu[3] + pu[4] + pu[0] * (unsigned)sizeof(PropPiece) + pu[1] * (unsigned)sizeof(PropType) +
                    pu[2] * (unsigned)sizeof(PropDef) + pu[6] * 12u;   // 32=заголовок; далее vertBytes+idxBytes+кус.+тип.+экз.+монеты
      if (!memcmp(ph, "PRP2", 4)) sz = *(unsigned *)(ph + 40);   // PRP2: @40 — размер всей секции (PRP1 + SPR1)
      void *m = memalign(16, sz);
      sceIoLseek32(fd, propOff, PSP_SEEK_SET);
      if (m && sceIoRead(fd, m, sz) == (int)sz && propsInit(&props, m, sz) == 0) {
        haveProps = 1;
        if (props.coinType >= 0 && props.ncoin && coinsInit(&coins, props.coinPos, props.ncoin) == 0) { haveCoins = 1; coins.dropAuto = 1; }   // пока игрок всегда в машине
        props.onKick = onPropKick;   // частицы удара по типу (PRP2 @44) + обломки SPR1
        if (props.spr && spInit(&sprops, props.spr, props.sprSize) == 0) {
          haveSP = 1;
        }
      }
      else if (m) free(m);
    }
  }
  { unsigned carOff = *(unsigned *)(hdr + 100);   // CAR1 (машина): после PRP1, до PVS1; секция < 4 КБ
    if (carOff) {
      static unsigned char cb[4096]; unsigned sz = sizeof cb;
      if (pvsOff > carOff && pvsOff - carOff < sz) sz = pvsOff - carOff;
      sceIoLseek32(fd, carOff, PSP_SEEK_SET);
      int n = sceIoRead(fd, cb, sz);
      if (n > 0 && carVisInit(&cv, cb, (unsigned)n) == 0) haveCarVis = 1;
    } }
  sceIoClose(fd);

  size_t p = 104;
  hm = (short *)(data + p); p += (size_t)hw * hh * 4 * 2; p = (p + 15) & ~15;
  wl = (short *)(data + p); p += (size_t)hw * hh * 2 * 2; p = (p + 15) & ~15;
  tex = calloc(ntex ? ntex : 1, sizeof(Tex));
  for (unsigned i = 0; i < ntex; i++) {
    unsigned short *t2 = (unsigned short *)(data + p);
    tex[i].w = t2[0]; tex[i].h = t2[1]; tex[i].levels = t2[2];
    tex[i].pal = data + p + 16; p += 16 + 1024;
    int lw = tex[i].w, lh = tex[i].h;
    for (int l = 0; l < tex[i].levels; l++) { tex[i].lv[l] = data + p; p += lw * lh; p = (p + 15) & ~15; lw >>= 1; lh = lh > 1 ? lh >> 1 : 1; }
  }
  swizzleAll();
  pc = calloc(npc ? npc : 1, sizeof(Piece));
  carP = malloc(2 * (npc ? npc : 1)); skyP = malloc(2 * (npc ? npc : 1));
  for (unsigned i = 0; i < npc; i++) {
    memcpy(&pc[i].r, data + tableOff + 80 * i, 80);
    float *b = pc[i].r.bb;
    pc[i].cx = (b[0] + b[3]) * .5f; pc[i].cy = (b[1] + b[4]) * .5f; pc[i].cz = (b[2] + b[5]) * .5f;
    float dx = b[3] - b[0], dy = b[4] - b[1], dz = b[5] - b[2]; pc[i].rad = .5f * sqrtf(dx * dx + dy * dy + dz * dz);
    if (pc[i].r.owner == 1) carP[ncarP++] = i;
    if (pc[i].r.owner == 2) skyP[nskyP++] = i;
  }
  cl = calloc(ncell ? ncell : 1, sizeof(Cell));
  for (unsigned i = 0; i < ncell; i++) {
    memcpy(&cl[i], data + cellOff + 48 * i, 48);
    float *b = cl[i].bb;
    cl[i].cx = (b[0] + b[3]) * .5f; cl[i].cy = (b[1] + b[4]) * .5f; cl[i].cz = (b[2] + b[5]) * .5f;
    float dx = b[3] - b[0], dy = b[4] - b[1], dz = b[5] - b[2]; cl[i].rad = .5f * sqrtf(dx * dx + dy * dy + dz * dz);
    cl[i].state = 0; cl[i].mem = 0;
  }
  sceKernelDcacheWritebackAll();

  // машина, небо и всё вокруг старта — сразу, остальное фоном
  SceUID lfd = sceIoOpen(path, PSP_O_RDONLY, 0);
  for (unsigned i = 0; i < ncell; i++)
    if (cl[i].owner || cellDist(&cl[i], spx, spy, spz) < (longView ? DIST_LONG : DIST_SHORT) + 10.f) loadCell(lfd, i);   // весь видимый круг, без дыр на старте
  sceIoClose(lfd);
  skyFogColor();
  { char fn[256]; sibling(fn, "view60"); SceUID v6 = sceIoOpen(fn, PSP_O_RDONLY, 0); if (v6 >= 0) { sceIoClose(v6); longView = 0; } }   // служебное: старт в режиме 60 FPS / 115 м
  { char fn[256], b[16]; sibling(fn, "oldstream"); SceUID o = sceIoOpen(fn, PSP_O_RDONLY, 0); if (o >= 0) { sceIoClose(o); oldStream = 1; }
    sibling(fn, "oldfog"); o = sceIoOpen(fn, PSP_O_RDONLY, 0); if (o >= 0) { sceIoClose(o); fogCol = SKY & 0xffffff; oldFog = 1; }
    sibling(fn, "flypath"); o = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (o >= 0) { int n = sceIoRead(o, b, 15); sceIoClose(o); b[n > 0 ? n : 0] = 0; flyPathV = n > 0 ? strtof(b, 0) : 30.f; if (flyPathV <= 0.f) flyPathV = 30.f; }
    sibling(fn, "slowio"); SceUID f = sceIoOpen(fn, PSP_O_RDONLY, 0);   // служебное: КБ/с медленной карты
    sibling(fn, "streamlog"); SceUID g = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (g >= 0) { int n = sceIoRead(g, b, 15); sceIoClose(g); b[n > 0 ? n : 0] = 0; stLogAt = n > 0 ? strtof(b, 0) : 30.f; if (stLogAt <= 0.f) stLogAt = 30.f; }
    if (f >= 0) { int n = sceIoRead(f, b, 15); sceIoClose(f); b[n > 0 ? n : 0] = 0; slowIoKBs = n > 0 ? strtoul(b, 0, 10) : 1500; if (!slowIoKBs) slowIoKBs = 1500; } }
  sema = sceKernelCreateSema("load", 0, 0, 1, NULL);
  SceUID lt = sceKernelCreateThread("loader", loaderThread, 0x18, 0x4000, 0, 0);   // выше главного: чтение короткое, ждёт карту памяти
  if (lt >= 0) sceKernelStartThread(lt, 0, 0);

  void *fbp0 = (void *)0, *fbp1 = (void *)(BUF_W * SCR_H * 4), *zbp = (void *)(BUF_W * SCR_H * 8);
  sceGuInit(); sceGuStart(GU_DIRECT, list);
  sceGuDrawBuffer(GU_PSM_8888, fbp0, BUF_W); sceGuDispBuffer(SCR_W, SCR_H, fbp1, BUF_W);
  sceGuDepthBuffer(zbp, BUF_W);
  sceGuOffset(2048 - SCR_W / 2, 2048 - SCR_H / 2); sceGuViewport(2048, 2048, SCR_W, SCR_H);
  sceGuDepthRange(65535, 0); sceGuScissor(0, 0, SCR_W, SCR_H); sceGuEnable(GU_SCISSOR_TEST);
  sceGuDepthFunc(GU_GEQUAL); sceGuEnable(GU_DEPTH_TEST); sceGuDisable(GU_CULL_FACE);
  sceGuShadeModel(GU_SMOOTH); sceGuEnable(GU_CLIP_PLANES);
  sceGuBlendFunc(GU_ADD, GU_SRC_ALPHA, GU_ONE_MINUS_SRC_ALPHA, 0, 0);
  sceGuAlphaFunc(GU_GREATER, 0x40, 0xff);
  sceGuFinish(); sceGuSync(0, 0);
  sceDisplayWaitVblankStart(); sceGuDisplay(GU_TRUE);
  hudInit(); fxInit();
  if (haveSP) {   // после fxInit: окна EFX стейтпропов -> родные системы fx.shr по имени; частицы обломков играет onPropKick
    for (unsigned k = 0; k < spFxNameCount(&sprops); k++) spFxBind(&sprops, k, fxFind(spFxName(&sprops, k)));
    sprops.nativeBreakFx = props.typeFx && fxReady();
  }

  float x = spx, y = spy, z = spz, h = sph, v = 0, vy = 0, steer = 0;
  if (haveCol) { carInit(&car, NULL, &world, spx, spy, spz, sph); x = car.x; y = car.y; z = car.z; }
  { float g; if (ground(x, z, y + 2.f, 0.f, &g)) y = g; }
  int fly = 0, hud = 1, pending = 0, autob = 0, frames = 0, hudTick = 0; unsigned prev = 0;
  float fx = x, fy = y + 3, fz = z, fyaw = 0, fpitch = -.2f, fps = 0, workMs = 0, workMax = 0, cpuMs = 0, shownMax = 0;
  float camx = x - sinf(h) * 7, camy = y + 3, camz = z - cosf(h) * 7;
  sceCtrlSetSamplingCycle(0); sceCtrlSetSamplingMode(PSP_CTRL_MODE_ANALOG);
  unsigned last = sceKernelGetSystemTimeLow(), acc = last, optUser;
  SceCtrlData pad;
  // служебное: файл autobench рядом с EBOOT -> тест-прогон сразу и выход (для проверки в эмуляторе)
  { char fn[256]; sibling(fn, "autobench"); SceUID f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); autob = 1; }
    sibling(fn, "pvscheck"); f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); autob = 3; }
    sibling(fn, "autodrive"); f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); autodrive = 1; }
    sibling(fn, "autostraight"); f = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (f >= 0) { char b[16]; int n = sceIoRead(f, b, 15); sceIoClose(f); autodrive = 2; if (n > 0) { b[n] = 0; adStop = strtof(b, 0); } }   // число в файле — через сколько секунд тормозить (проверка пропов)
    sibling(fn, "testdmg"); f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); car.damage = prevDmg = .9f; }   // служебное: дым/огонь сразу
    sibling(fn, "testboom"); f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); car.damage = prevDmg = 1.f; car.destroyed = 1; }   // служебное: остов сразу
    sibling(fn, "slowmo"); f = sceIoOpen(fn, PSP_O_RDONLY, 0); if (f >= 0) { sceIoClose(f); slowmo = 1; } }
  // служебное: opts.txt (маска переключателей, hex) и goto.txt (x z курс) — для сравнения картинок
  { char fn[256], b[64]; sibling(fn, "opts.txt"); SceUID f = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (f >= 0) { int n = sceIoRead(f, b, 63); sceIoClose(f); if (n > 0) { b[n] = 0; opt = strtoul(b, 0, 16); } }
    sibling(fn, "goto.txt"); f = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (f >= 0) { int n = sceIoRead(f, b, 63); sceIoClose(f);
      if (n > 0) { b[n] = 0; char *e; x = strtof(b, &e); z = strtof(e, &e); h = strtof(e, 0); y = 200; float g; if (ground(x, z, y, 0.f, &g)) y = g;
        if (haveCol) { carPlace(&car, &world, x, y, z, h); x = car.x; y = car.y; z = car.z; h = car.h; }   // этап 3б: goto.txt ставит и машину, не только камеру
        camx = x - sinf(h) * 7.5f; camy = y + 3.2f; camz = z - cosf(h) * 7.5f; } } }

  // служебное (проверка машины снимками): camang.txt — угол камеры вокруг машины, рад; carseq.txt — steer/brake/rev/drive
  { char fn[256], b[32]; sibling(fn, "camang.txt"); SceUID f = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (f >= 0) { int n = sceIoRead(f, b, 31); sceIoClose(f); if (n > 0) { b[n] = 0; camAng = strtof(b, 0); } }
    sibling(fn, "carseq.txt"); f = sceIoOpen(fn, PSP_O_RDONLY, 0);
    if (f >= 0) { int n = sceIoRead(f, b, 31); sceIoClose(f); if (n > 0) { b[n] = 0;
      carSeq = b[0] == 's' ? 1 : b[0] == 'b' ? 2 : b[0] == 'r' ? 3 : b[0] == 'd' ? 4 : 0; } }
    if (camAng != 0.f) { camx = x - sinf(h + camAng) * 7.5f; camz = z - cosf(h + camAng) * 7.5f; } }

  optUser = opt;
  for (;;) {
    unsigned t0 = sceKernelGetSystemTimeLow();
    sceCtrlPeekBufferPositive(&pad, 1);
    float dt = (t0 - last) / 1000000.f; last = t0; if (dt > .05f) dt = .05f; if (slowmo) dt *= .25f;   // служебное: замедление для снимков
    { float n = floorf(dt * 60.f + .5f); if (n >= 1.f && fabsf(dt - n * (1.f / 60.f)) < .002f) dt = n * (1.f / 60.f); }   // шаг кадра = ровно N кадров развёртки: иначе дрожь таймера даёт 1 или 3 подшага физики вместо 2 — машина дёргается
    unsigned hit = pad.Buttons & ~prev; prev = pad.Buttons;
    float ax = (pad.Lx - 128) / 128.f, ay = (pad.Ly - 128) / 128.f;
    if (fabsf(ax) < .2f) ax = 0; if (fabsf(ay) < .2f) ay = 0;
    if (autob == 1) { hit |= PSP_CTRL_CIRCLE; autob = 2; }
    if (autob == 3) { benchStart(); bpass = 5; fbA = memalign(16, BUF_W * SCR_H * 4); memset(pcDiff, 0, sizeof pcDiff); autob = 2; }
    if (autob == 2 && bpass == 0 && brep[0][0]) sceKernelExitGame();
    if (hit & PSP_CTRL_SELECT) { if (pad.Buttons & PSP_CTRL_RTRIGGER) hud = !hud; else longView = !longView; }   // SELECT: 30 FPS/250 м <-> 60 FPS/115 м; R+SELECT: счётчик
    if (hit & PSP_CTRL_CIRCLE) {
      if (bpass || brep[0][0]) { bpass = 0; brep[0][0] = 0; opt = optUser; }
      else { benchStart(); fly = 0; }
    }
    if (hit & PSP_CTRL_TRIANGLE) { fly = !fly; fx = camx; fy = camy; fz = camz; fyaw = atan2f(x - camx, -(z - camz)); fpitch = -.2f; }
    if (hit & PSP_CTRL_START) {
      x = spx; y = spy; z = spz; h = sph; v = vy = 0; float g; if (ground(x, z, y + 2.f, 0.f, &g)) y = g;
      if (haveCol) { carPlace(&car, &world, spx, spy, spz, sph); x = car.x; y = car.y; z = car.z; h = car.h; }
      car.damage = 0.f; car.destroyed = 0; prevDmg = 0.f; wasDestroyed = 0;   // START — как ремонт (ключ/будка — этап 8а)
    }

    float cfx, cfy, cfz, ex, ey, ez;
    if (bpass) {
      benchBefore(pending, sph, &x, &y, &z, &h); v = vy = 0;
      camx = x - sinf(h) * 7.5f; camy = y + 3.2f; camz = z - cosf(h) * 7.5f; chase.init = 0;
      ex = camx; ey = camy; ez = camz;
      cfx = x - camx; cfy = (y + 1.4f) - camy; cfz = z - camz;
      float l = sqrtf(cfx * cfx + cfy * cfy + cfz * cfz); cfx /= l; cfy /= l; cfz /= l;
    } else if (!fly && haveCol) {                  // этап 2: машина через col.c/car.c
      float st = ax;
      if (pad.Buttons & PSP_CTRL_LEFT) st = -1; if (pad.Buttons & PSP_CTRL_RIGHT) st = 1;
      CarInput in = { (pad.Buttons & PSP_CTRL_CROSS) ? 1.f : 0.f,
                      (pad.Buttons & (PSP_CTRL_SQUARE | PSP_CTRL_LTRIGGER)) ? 1.f : 0.f, st };
      in.handbrake = (pad.Buttons & PSP_CTRL_RTRIGGER) ? 1.f : 0.f;          // R — ручник (занос)
      if (autodrive) { adT += dt; in.throttle = 1; in.brake = 0; in.steer = autodrive == 2 ? 0.f : sinf(adT * .7f) * .5f;   // служебный автопилот
        if (adStop > 0.f && adT > adStop) { in.throttle = 0; in.brake = car.v > .5f ? 1.f : 0.f; in.handbrake = 1.f; } }
      if (carSeq) {   // служебное: руль вправо стоя / тормоз на 5 м/с / назад / круг с рулём вправо
        in.steer = carSeq == 1 || carSeq == 4 ? 1.f : 0.f; in.throttle = carSeq == 4 ? .6f : 0.f; in.brake = carSeq == 2 || carSeq == 3 ? 1.f : 0.f;
        if (carSeq == 2) carSetSpeed(&car, 5.f); if (carSeq == 3) carSetSpeed(&car, -1.f);
      }
      if (car.destroyed) { in.throttle = 0.f; in.brake = 0.f; in.handbrake = 1.f; }   // взорвалась — не едет (START чинит); тормоз стоя = задний ход, поэтому ручник
      carUpdate(&car, &world, &in, dt);
      if (haveCarVis) carVisUpdate(&cv, &car, &in, dt);   // CAR1: колёса, шарниры, зоны урона, фонари
      if (haveProps) propsUpdate(&props, &world, &car, dt);
      if (haveSP) {   // стейтпропы: машина состояний, удары машины, монеты; частицы — пресеты в fx.c
        spUpdate(&sprops, &world, &car, haveCoins ? &coins : NULL, dt);
        SpFxOut o;
        while (spFxPop(&sprops, &o)) {
          if (o.sys >= 0) { float p3[3] = {o.x, o.y, o.z}; fxBurst(o.sys, p3, NULL); continue; }   // родная система окна EFX
          float r1 = rand() * (1.f / RAND_MAX) - .5f, r2 = rand() * (1.f / RAND_MAX), r3 = rand() * (1.f / RAND_MAX) - .5f;
          switch (o.preset) {
            case SPFX_GLASS: case SPFX_SPARKS: fxSpawn(FX_SPARK, o.x, o.y, o.z, r1 * 8.f, r2 * 5.f + 1.f, r3 * 8.f); break;
            case SPFX_FIRE: fxSpawn(FX_FIRE, o.x, o.y, o.z, r1 * 1.5f, r2 * 2.f + 1.f, r3 * 1.5f); break;
            case SPFX_SMOKE: fxSpawn(FX_DARK, o.x, o.y, o.z, r1, r2 + .5f, r3); break;
            case SPFX_WATER: fxSpawn(FX_SMOKE, o.x, o.y, o.z, r1 * 1.5f, r2 * 3.f + 5.f, r3 * 1.5f); break;
            default: fxSpawn(FX_SMOKE, o.x, o.y, o.z, r1 * 4.f, r2 * 3.f + .5f, r3 * 4.f); break;   // пыль, щепа, листья, сено, томаты
          }
        }
      }
      if (haveCoins) coinsUpdate(&coins, car.x, car.y + 0.8f, car.z, 1, dt);
      { // эффекты урона: искры при ударе, дым по степени урона, огонь, взрыв
        float sh = sinf(car.h), chh = cosf(car.h), hx = car.x + sh * 1.7f, hz = car.z + chh * 1.7f, hy = car.ry + 1.0f;
        { float sl[3]; if (haveCarVis && carVisJointWorld(&cv, &car, cv.slJ, sl)) { hx = sl[0]; hy = sl[1]; hz = sl[2]; } }   // CAR1: дым из локатора sl с наклоном кузова
        #define FR() (rand() * (1.f / RAND_MAX))
        if (car.damage > prevDmg + 1e-4f) {
          int n = 6 + (int)((car.damage - prevDmg) * 300.f); if (n > 30) n = 30;
          float sx = hx, sz = hz;
          if (car.v < 0) { sx = car.x - sh * 1.9f; sz = car.z - chh * 1.9f; }
          for (int k = 0; k < n; k++)
            fxSpawn(FX_SPARK, sx, car.ry + 0.6f, sz, (FR() - .5f) * 8.f + car.vel[0] * .3f, FR() * 5.f + 1.f, (FR() - .5f) * 8.f + car.vel[2] * .3f);
        }
        prevDmg = car.damage;
        { // дым/огонь: родная система car_damage3 (inst 14), одна на машину; стадии — множители эмиттеров
          static int hDmg, hHusk;
          float sp[3] = {hx, hy, hz};
          int stage = car.destroyed ? 4 : car.damage >= .85f ? 3 : car.damage >= .6f ? 2 : car.damage >= .33f ? 1 : 0;
          if (stage) {
            if (!fxAlive(hDmg)) hDmg = fxStartSystem(fxFindInst(14), sp, NULL);
            fxMove(hDmg, sp, NULL);
            fxSetEmitRate(hDmg, 0, stage == 1 ? .4f : 1.f);   // darksmoke
            fxSetEmitRate(hDmg, 1, stage >= 3 ? 1.f : 0.f);   // fireSeqEm1
            fxSetEmitRate(hDmg, 2, stage >= 3 ? 1.f : 0.f);   // fireSeqEm2
          } else if (hDmg) { fxStop(hDmg); hDmg = 0; }
          if (car.destroyed) {   // горящий остов: FireSpray (inst 19)
            float gp[3] = {car.x, car.ry + .3f, car.z};
            if (!fxAlive(hHusk)) hHusk = fxStartSystem(fxFindInst(19), gp, NULL);
            fxMove(hHusk, gp, NULL);
          } else if (hHusk) { fxStop(hHusk); hHusk = 0; }
        }
        if (car.destroyed && !wasDestroyed) {   // взрыв: обломок 24 BurstShape (24 эмиттера) + кольцо, пятно гари, вспышка
          float gp[3] = {car.x, car.ry, car.z};
          fxBurstBreakable(24, gp, NULL);
        }
        wasDestroyed = car.destroyed;
      }
      x = car.x; y = car.ry; z = car.z; h = car.h; v = car.v;
      { float cp[3], lk[3]; chaseCamUpdate(&car, camAng, dt, cp, lk);   // камера как в оригинале (см. chaseCamUpdate)
        camx = cp[0]; camy = cp[1]; camz = cp[2];
        ex = camx; ey = camy; ez = camz;
        cfx = lk[0] - camx; cfy = lk[1] - camy; cfz = lk[2] - camz; }
      float l = sqrtf(cfx * cfx + cfy * cfy + cfz * cfz); cfx /= l; cfy /= l; cfz /= l;
    } else if (!fly) {
      float st = ax;
      if (pad.Buttons & PSP_CTRL_LEFT) st = -1; if (pad.Buttons & PSP_CTRL_RIGHT) st = 1;
      steer += (st - steer) * fminf(1.f, dt * 8.f);
      int gas = pad.Buttons & (PSP_CTRL_CROSS | PSP_CTRL_RTRIGGER);
      int brake = pad.Buttons & (PSP_CTRL_SQUARE | PSP_CTRL_LTRIGGER);
      if (gas) v += (v < 0 ? 30.f : 14.f) * dt;
      else if (brake) v -= (v > 0 ? 30.f : 8.f) * dt;
      else v -= v * 1.2f * dt;
      if (v > 30.f) v = 30.f; if (v < -9.f) v = -9.f;
      float turn = steer * 2.1f * fminf(1.f, fabsf(v) / 6.f) / (1.f + fabsf(v) / 25.f);
      h -= turn * dt * (v >= 0 ? 1.f : -1.f);
      float nx = x + sinf(h) * v * dt, nz = z + cosf(h) * v * dt, g;
      float bump = v >= 0 ? 2.2f : -2.2f;   // нос/багажник машины
      float px = nx + sinf(h) * bump, pz = nz + cosf(h) * bump;
      int stuck = wallAt(x, z, y);          // если застряли в стене — выпускаем
      if (ground(nx, nz, y, 1.0f, &g) && g > y - 25.f && (stuck || (!wallAt(px, pz, y) && !wallAt(nx, nz, y)))) { x = nx; z = nz; }
      else v = -v * .2f;
      if (ground(x, z, y, 1.0f, &g)) {
        if (g >= y - .35f && vy <= 0) { y = g; vy = 0; }
        else { vy -= 22.f * dt; y += vy * dt; if (y < g) { y = g; vy = 0; } }
      } else { vy -= 22.f * dt; y += vy * dt; }
      if (y < -200) { x = spx; y = spy; z = spz; v = vy = 0; }
      float tx = x - sinf(h) * 7.5f, tz = z - cosf(h) * 7.5f, ty = y + 3.2f, k = fminf(1.f, dt * 5.f);
      camx += (tx - camx) * k; camy += (ty - camy) * k; camz += (tz - camz) * k;
      ex = camx; ey = camy; ez = camz;
      cfx = x - camx; cfy = (y + 1.4f) - camy; cfz = z - camz;
      float l = sqrtf(cfx * cfx + cfy * cfy + cfz * cfz); cfx /= l; cfy /= l; cfz /= l;
    } else {
      fyaw += ax * 2.f * dt; fpitch -= ay * 1.5f * dt;
      if (fpitch > 1.5f) fpitch = 1.5f; if (fpitch < -1.5f) fpitch = -1.5f;
      float sp_ = (pad.Buttons & PSP_CTRL_CROSS) ? 60.f : 15.f;
      cfx = sinf(fyaw) * cosf(fpitch); cfy = sinf(fpitch); cfz = -cosf(fyaw) * cosf(fpitch);
      float rx = cosf(fyaw), rz = sinf(fyaw);
      if (pad.Buttons & PSP_CTRL_UP) { fx += cfx * sp_ * dt; fy += cfy * sp_ * dt; fz += cfz * sp_ * dt; }
      if (pad.Buttons & PSP_CTRL_DOWN) { fx -= cfx * sp_ * dt; fy -= cfy * sp_ * dt; fz -= cfz * sp_ * dt; }
      if (pad.Buttons & PSP_CTRL_RIGHT) { fx += rx * sp_ * dt; fz += rz * sp_ * dt; }
      if (pad.Buttons & PSP_CTRL_LEFT) { fx -= rx * sp_ * dt; fz -= rz * sp_ * dt; }
      if (pad.Buttons & PSP_CTRL_RTRIGGER) fy += sp_ * dt;
      if (pad.Buttons & PSP_CTRL_LTRIGGER) fy -= sp_ * dt;
      ex = fx; ey = fy; ez = fz;
    }

    if (flyPathV > 0.f) flyPathStep(dt, &ex, &ey, &ez, &cfx, &cfy, &cfz);   // служебное: замер стриминга
    drawDist = (opt & O_D100) ? 100.f : longView ? DIST_LONG : DIST_SHORT;   // до stream(): радиусы загрузки идут от дальности
    pending = stream(ex, ey, ez);
    eyeX = ex; eyeY = ey; eyeZ = ez; cfX = cfx; cfY = cfy; cfZ = cfz;
    setupPlanes(cfx, cfy, cfz);
    cullCity(fly);
    streamMiss();

    sceGuStart(GU_DIRECT, list);
    resetState(); drawnTris = 0; draws = 0; binds = 0;
    if (opt & O_QVP) { sceGuViewport(2048, 2048, SCR_W / 2, SCR_H / 2); sceGuScissor(SCR_W / 4, SCR_H / 4, SCR_W * 3 / 4, SCR_H * 3 / 4); }
    else { sceGuViewport(2048, 2048, SCR_W, SCR_H); sceGuScissor(0, 0, SCR_W, SCR_H); }
    sceGuEnable(GU_DEPTH_TEST); sceGuDepthFunc(GU_GEQUAL); sceGuShadeModel(GU_SMOOTH);
    sceGuTexWrap(GU_REPEAT, GU_REPEAT); sceGuTexFunc(GU_TFX_MODULATE, GU_TCC_RGBA);
    sceGuTexScale(128.f, 128.f); sceGuTexOffset(0.f, 0.f); sceGuTexLevelMode(GU_TEXTURE_AUTO, 0.f);
    sceGuClutMode(GU_PSM_8888, 0, 0xff, 0);
    fogBase();   // цвет горизонта неба (skyFogColor), не яркий голубой
    sceGuClearColor(0xff000000 | fogCol); sceGuClearDepth(0);
    sceGuClear(GU_COLOR_BUFFER_BIT | GU_DEPTH_BUFFER_BIT);
    sceGumMatrixMode(GU_PROJECTION); sceGumLoadIdentity();
    sceGumPerspective(FOVY, ASPECT, 0.7f, drawDist + 10.f);
    sceGumMatrixMode(GU_VIEW); sceGumLoadIdentity();
    ScePspFVector3 eye = {ex, ey, ez}, at = {ex + cfx, ey + cfy, ez + cfz}, up = {0, 1, 0};
    sceGumLookAt(&eye, &at, &up);
    sceGumMatrixMode(GU_MODEL); sceGumLoadIdentity();
    sceGumUpdateMatrix();

    // небо: вокруг камеры, без тумана и без глубины (слои в порядке файла); сектора за кадром не рисуем
    if (opt & O_SKY) {
      sceGuDisable(GU_FOG); sceGuDisable(GU_DEPTH_TEST);
      for (int i = 0; i < nskyP; i++) {
        Piece *d = &pc[skyP[i]]; if (cl[d->r.cell].state != 2) continue;
        if ((opt & O_SKYCULL) && !visBox(d->r.bb, ex, ey, ez)) continue;
        drawPiece(d, 0, ex, ey, ez, 1, 0);
      }
      sceGuEnable(GU_DEPTH_TEST);
    }
    sceGuEnable(GU_FOG);
    // полупрозрачное города, машины, пропов и монет — в очередь, рисуется после них (tqFlush ниже)
    ntq = 0; tqOn = (opt & O_LEAN) != 0; tqEx = ex; tqEy = ey; tqEz = ez;
    // город: отсортированный список
    if (opt & O_LEAN) { for (int i = 0; i < nd; i++) { fogRadial(&pc[sp[i]], sf[i]); drawPiece(&pc[sp[i]], sf[i], 0, 0, 0, 1, 0); } fogBase(); }
    else {
      sceGumMatrixMode(GU_MODEL); sceGumLoadIdentity(); resetState();
      for (int i = 0; i < nd; i++) drawPieceLegacy(&pc[sp[i]], sf[i]);
      resetState();
    }
    // машина
    if (haveCarVis && haveCol && !bpass) { carVisDrawShadow(&cv, &car, &world); resetState(); }   // CAR1: тень-пятно
    { float ca = cosf(h + GU_PI), sa = sinf(h + GU_PI);
      for (int i = 0; i < ncarP; i++) {
        Piece *d = &pc[carP[i]]; if (cl[d->r.cell].state != 2) continue;
        int joint = d->r.pad[0], variant = d->r.pad[1];   // CAR1: сустав и вариант (0 машина, 1 остов)
        if (haveCarVis && haveCol && !bpass) {         // с наклоном по дороге + анимация суставов, урон, остов
          if (!carVisVariantOn(&car, variant)) continue;
          float m[16]; carVisPieceMatrix(&cv, &car, joint, variant, d->r.ox, d->r.oy, d->r.oz, d->r.sc, m);
          int t0 = d->r.tex; d->r.tex = carVisTex(&cv, t0);
          drawPieceM(d, (const ScePspFMatrix4 *)m); d->r.tex = t0;
        } else if (haveCol && !bpass && !haveCarVis) {   // старый level.shr без CAR1
          float m[16]; carPieceMatrix(&car, lift, d->r.ox, d->r.oy, d->r.oz, d->r.sc, m);
          drawPieceM(d, (const ScePspFMatrix4 *)m);
        } else {                                       // тест-прогон: машина в позе покоя
          if (variant) continue;
          Piece t = *d;
          if (haveCarVis && joint < cv.njoint) { t.r.ox += cv.joint[joint].x; t.r.oy += cv.joint[joint].y; t.r.oz += cv.joint[joint].z; }
          drawPiece(&t, 0, x, y + lift, z, ca, sa);
        }
      } }
    if (haveCarVis && haveCol && !bpass) { carVisDrawFlares(&cv, &car, ex, ey, ez, bindTexLean); resetState(); }   // CAR1: стоп-сигналы / задний ход
    // пропы (этап 3б): грубая отсечка по расстоянию от камеры, пробуждение — в props.c
    if (haveProps) {
      for (unsigned i = 0; i < props.ninst; i++) {
        PropDef *pd = &props.def[i]; PropState *st = &props.st[i]; PropType *ty = &props.types[pd->type];
        if (st->hidden) continue;   // вместо него играет обломок (SPR1)
        float ddx = st->x - ex, ddz = st->z - ez;
        { float pr = drawDist * .92f; if (ddx * ddx + ddz * ddz > pr * pr) continue; }   // до почти полной дымки, без «выскакивания»
        { float r = ty->radius + 2.f * ty->halfH + 1.f, bb[6] = {st->x - r, st->y - r, st->z - r, st->x + r, st->y + r, st->z + r};
          if (!visBox(bb, 0, 0, 0)) continue; }   // за кадром не рисуем (при 250 м пропов в круге сотни; раньше GE резал их сам)
        for (unsigned k = 0; k < ty->nPiece; k++) {
          PropPiece *pp = &props.pieces[ty->firstPiece + k];
          if (pp->ni <= 0) continue;
          float m[16]; propPieceMatrix(st, pp->ox, pp->oy, pp->oz, pp->sc, m);
          Piece tmp; memset(&tmp, 0, sizeof tmp);
          tmp.r.tex = pp->tex; tmp.r.flags = pp->flags; tmp.r.ni = pp->ni;
          tmp.v = (Vert *)((char *)props.vertBase + pp->vOff);
          tmp.idx = (unsigned short *)((char *)props.idxBase + pp->iOff);
          drawPieceM(&tmp, (const ScePspFMatrix4 *)m);
        }
      }
    }
    // стейтпропы и обломки: куски на суставах (жёсткие), видимость по состоянию и кадру; потом билборды
    if (haveSP) {
      for (unsigned i = 0; i < sprops.ninst; i++) {
        if (!spDrawable(&sprops, i, ex, ez, drawDist * .92f)) continue;
        const SpType *T = &sprops.type[sprops.inst[i].type];
        spPose(&sprops, i);
        for (unsigned k = 0; k < T->nPiece; k++) {
          if (!spPieceOn(&sprops, i, k)) continue;
          const SpPiece *pp = &sprops.piece[T->firstPiece + k];
          if (!pp->ni) continue;
          float m[16]; spPieceMatrix(&sprops, i, k, m);
          Piece tmp; memset(&tmp, 0, sizeof tmp);
          tmp.r.tex = pp->tex; tmp.r.flags = pp->flags & 0xFF; tmp.r.ni = pp->ni;
          tmp.v = (Vert *)((char *)sprops.vertBase + pp->vOff);
          tmp.idx = (unsigned short *)((char *)sprops.idxBase + pp->iOff);
          drawPieceM(&tmp, (const ScePspFMatrix4 *)m);
        }
      }
      // билборды (тень ящика, свет автомата, дым будки, дуги щитка): квадраты без записи глубины, после непрозрачного
      int nb = 0;
      for (unsigned i = 0; i < sprops.ninst; i++) {
        if (!spDrawable(&sprops, i, ex, ez, 60.f)) continue;
        const SpType *T = &sprops.type[sprops.inst[i].type];
        for (unsigned b = 0; b < T->nBill; b++) {
          float v[12]; uint32_t col, bfl; int bt;
          if (!spBillQuad(&sprops, i, b, ex, ey, ez, v, &col, &bt, &bfl) || !(col >> 24)) continue;
          if (!nb++) {
            ScePspFMatrix4 I; memset(&I, 0, sizeof I); I.x.x = I.y.y = I.z.z = I.w.w = 1.f;
            sceGuSetMatrix(GU_MODEL, &I); sceGuTexScale(1.f, 1.f);
            sceGuDisable(GU_ALPHA_TEST); sceGuEnable(GU_BLEND); sceGuDepthMask(GU_TRUE); curFlags = -1;
          }
          int blm = (bfl >> 8) & 0xFF;   // BLMD шейдера: 2 — сложение, 3 — вычитание (тень), иначе обычная прозрачность
          if (blm == 2) sceGuBlendFunc(GU_ADD, GU_SRC_ALPHA, GU_FIX, 0, 0xffffffff);
          else if (blm == 3) sceGuBlendFunc(GU_REVERSE_SUBTRACT, GU_SRC_ALPHA, GU_FIX, 0, 0xffffffff);
          else sceGuBlendFunc(GU_ADD, GU_SRC_ALPHA, GU_ONE_MINUS_SRC_ALPHA, 0, 0);
          typedef struct { float u, v; unsigned c; float x, y, z; } BV;
          BV *q = (BV *)sceGuGetMemory(4 * sizeof(BV));
          static const float uv[8] = {0, 1, 1, 1, 0, 0, 1, 0};
          for (int k = 0; k < 4; k++) { q[k].u = uv[2 * k]; q[k].v = uv[2 * k + 1]; q[k].c = col; q[k].x = v[3 * k]; q[k].y = v[3 * k + 1]; q[k].z = v[3 * k + 2]; }
          bindTexLean(bt);
          sceGuDrawArray(GU_TRIANGLE_STRIP, GU_TEXTURE_32BITF | GU_COLOR_8888 | GU_VERTEX_32BITF | GU_TRANSFORM_3D, 4, 0, q);
        }
      }
      if (nb) { sceGuTexScale(128.f, 128.f); sceGuBlendFunc(GU_ADD, GU_SRC_ALPHA, GU_ONE_MINUS_SRC_ALPHA, 0, 0); resetState(); }
    }
    // монеты: один меш, крутятся вокруг Y; выпавшие гаснут (масштаб), дальность 60 м как в оригинале
    if (haveCoins) {
      PropType *cty = &props.types[props.coinType];
      // без мипмапов: на 5 px мелкий уровень coinlogo даёт тёмное пятно (docs/pickups_spec.md)
      int ctex = props.pieces[cty->firstPiece].tex, clev = (ctex >= 0 && ctex < (int)ntex) ? tex[ctex].levels : 0;
      if (clev) { tex[ctex].levels = 1; bound = -2; }
      for (unsigned i = 0; i < coins.n; i++) {
        Coin *c = &coins.c[i];
        if (!c->active) continue;
        float ddx = c->x - ex, ddz = c->z - ez;
        if (ddx * ddx + ddz * ddz > 60.f * 60.f) continue;
        float a = coinAlpha(c), cs_ = cosf(c->spin) * a, sn = sinf(c->spin) * a;
        for (unsigned k = 0; k < cty->nPiece; k++) {
          PropPiece *pp = &props.pieces[cty->firstPiece + k];
          if (pp->ni <= 0) continue;
          float s_ = pp->sc, m[16] = {cs_ * s_, 0, -sn * s_, 0,  0, a * s_, 0, 0,  sn * s_, 0, cs_ * s_, 0,
                                      c->x + cs_ * pp->ox + sn * pp->oz, c->y + a * pp->oy, c->z - sn * pp->ox + cs_ * pp->oz, 1};
          Piece tmp; memset(&tmp, 0, sizeof tmp);
          tmp.r.tex = pp->tex; tmp.r.flags = pp->flags; tmp.r.ni = pp->ni;
          tmp.v = (Vert *)((char *)props.vertBase + pp->vOff);
          tmp.idx = (unsigned short *)((char *)props.idxBase + pp->iOff);
          drawPieceM(&tmp, (const ScePspFMatrix4 *)m);
        }
        if (ddx * ddx + ddz * ddz < 45.f * 45.f)   // блёстки монеты (слот частиц 0 оригинала: scratch2, аддитивно)
          fxSparkle(c->x, c->y + .32f * a, c->z, 1.1f * a, c->spin * .159f + i * .37f);
      }
      if (clev) { tex[ctex].levels = clev; bound = -2; }
    }
    tqFlush(); resetState();   // отложенное полупрозрачное: от дальнего к ближнему, глубину не пишет
    fxUpdate(dt); fxDraw(ex, ey, ez, cfx, cfy, cfz); resetState();
    sceGuDepthMask(GU_FALSE);
    if (hud && (opt & O_HUD)) { sceGuScissor(0, 0, SCR_W, SCR_H); hudDraw(); resetState(); }
    sceGuFinish();
    unsigned t3 = sceKernelGetSystemTimeLow();
    sceGuSync(0, 0);
    unsigned t4 = sceKernelGetSystemTimeLow();
    workMs = (t4 - t0) / 1000.f; cpuMs = (t3 - t0) / 1000.f; if (workMs > workMax) workMax = workMs;
    streamStat(workMs);

    curFb = (unsigned *)((unsigned)sceGeEdramGetAddr() + (unsigned)fbp0);
    int missed = 0;
    if (!bpass || bVsync) {
      int per = longView && !bpass ? 2 : 1;             // дальний режим: кадр ровно на 2 обратных хода = ровные 30 FPS
      do sceDisplayWaitVblankStart(); while ((int)(sceDisplayGetVcount() - lastVc) < per);
      unsigned vc = sceDisplayGetVcount(); missed = (int)(vc - lastVc) > per; lastVc = vc;
    }
    if (bpass) benchAfter(workMs, cpuMs, missed);
    fbp0 = sceGuSwapBuffers();

    frames++;
    if (t4 - acc >= 1000000) { fps = frames * 1000000.f / (t4 - acc); frames = 0; acc = t4; shownMax = workMax; workMax = 0; }
    if (++hudTick >= 15) {                           // текст счётчика обновляем 4 раза в секунду
      hudTick = 0; char s[96];
      hudClear();
      snprintf(s, sizeof s, "FPS %4.1f  tris %4.1fk  draws %d  RAM %.1fMB  %s %3.0f km/h", fps, drawnTris / 1000.f, draws,
               loadedBytes / 1048576.f, fly ? "FLY" : haveCol ? "CAR+COL" : "CAR", fabsf(v) * 3.6f);
      hudLine(0, 0xffffffff, s);
      snprintf(s, sizeof s, "work %4.1f ms (max %4.1f)  cpu %4.1f  %s  %s %3.0fm SEL", workMs, shownMax, cpuMs, pvsUsed ? "PVS" : "",
               longView ? "30FPS" : "60FPS", drawDist);
      hudLine(1, 0xffffffff, s);
      if (haveCoins) {   // временный счётчик (этап 7 — родной интерфейс): правый нижний угол
        char t[64]; snprintf(t, sizeof t, "COINS %d / %d   DMG %3.0f%%", coins.collected, coins.total, car.damage * 100.f);
        snprintf(s, sizeof s, "%*s", 60, t); hudLine(33, 0xff40d0ff, s);
      }
      hudLine(2, 0xffc0c0c0, fly ? "stick:look dpad:move L/R:down/up X:fast  /\\:car START:reset"
                                 : "X:gas []/L:brake R:handbrake stick:steer /\\:fly O:bench START:reset");
      if (bpass) {
        static const char *pn[] = {"", "P1 whole level", "P2 variants", "P3 vsync"};
        int tot = bpass == 1 ? nbp * 4 : bpass == 2 ? nw2 : nw3;
        snprintf(s, sizeof s, "BENCH %s  %d / %d %s", pn[bpass], bview, tot, bpass == 2 ? VAR[bvar].name : "");
        hudLine(4, 0xff80ffff, s);
      } else if (brep[0][0]) { hudLine(4, 0xff80ffff, brep[0]); hudLine(5, 0xff80ffff, brep[1]); }
    }
  }
  return 0;
}
